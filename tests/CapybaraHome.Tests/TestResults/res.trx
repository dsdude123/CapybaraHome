      LEFT JOIN "MealIngredients" AS "m1" ON "s"."Id" = "m1"."MealId"
      LEFT JOIN (
          SELECT "m2"."Id", "m2"."MealId", "m2"."Name", "m2"."DirectionsModifications", "m3"."Id" AS "Id0", "m3"."Quantity", "m3"."Item", "m3"."SortOrder", "m4"."MealIngredientId", "m4"."Id" AS "Id1", "m2"."SortOrder" AS "SortOrder0"
