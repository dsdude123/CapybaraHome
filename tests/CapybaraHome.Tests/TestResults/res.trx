      SELECT "m"."Name", "m"."PlannedSlot", "m"."PlannedVariantId", "m0"."Name", "m"."Id", "m0"."Id", "m1"."Id", "m1"."Quantity", "m1"."Item", "s"."Id", "s"."Quantity", "s"."Item", "s"."Id0", "s0"."MealIngredientId", "s0"."Id", "s0"."Id0"
      FROM "Meals" AS "m"
      LEFT JOIN "MealVariants" AS "m0" ON "m"."PlannedVariantId" = "m0"."Id"
      LEFT JOIN "MealIngredients" AS "m1" ON "m"."Id" = "m1"."MealId"
      LEFT JOIN (
          SELECT "m3"."Id", "m3"."Quantity", "m3"."Item", "m2"."Id" AS "Id0", "m2"."MealId"
          FROM "MealVariants" AS "m2"
          INNER JOIN "MealVariantIngredients" AS "m3" ON "m2"."Id" = "m3"."MealVariantId"
      ) AS "s" ON "m"."Id" = "s"."MealId" AND "m"."PlannedVariantId" = "s"."Id0"
      LEFT JOIN (
          SELECT "m5"."MealIngredientId", "m4"."Id", "m5"."Id" AS "Id0", "m4"."MealId"
          FROM "MealVariants" AS "m4"
          INNER JOIN "MealVariantRemovals" AS "m5" ON "m4"."Id" = "m5"."MealVariantId"
      ) AS "s0" ON "m"."Id" = "s0"."MealId" AND "m"."PlannedVariantId" = "s0"."Id"
      WHERE "m"."Status" IN ('Planned', 'PlannedShared')
      ORDER BY "m"."Id", "m0"."Id", "m1"."SortOrder", "m1"."Id", "s"."Id0", "s"."Id", "s0"."Id"
