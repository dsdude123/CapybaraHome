      FROM (
          SELECT "m"."Id", "m"."Name", "m"."Directions", "m"."Status", "m"."IsOneTime", "m"."LastCookedAt", "m"."PlannedSlot", "m"."PlannedMealCount", "m"."PlannedVariantId", "m0"."Name" AS "Name0", "m"."ImportedText", "m"."NeedsIngredientSplit", "m"."JiraKey", "m"."CreatedAt", "m"."UpdatedAt", "m0"."Id" AS "Id0"
          FROM "Meals" AS "m"
          LEFT JOIN "MealVariants" AS "m0" ON "m"."PlannedVariantId" = "m0"."Id"
          WHERE "m"."Id" = @id
          LIMIT 2
