          LEFT JOIN "MealVariantIngredients" AS "m3" ON "m2"."Id" = "m3"."MealVariantId"
          LEFT JOIN "MealVariantRemovals" AS "m4" ON "m2"."Id" = "m4"."MealVariantId"
      ) AS "s0" ON "s"."Id" = "s0"."MealId"
      LEFT JOIN (
          SELECT "m6"."Id", "m6"."Name", "m6"."Facet", "m5"."MealsId", "m5"."TagsId"
          FROM "MealTagLinks" AS "m5"
          INNER JOIN "MealTags" AS "m6" ON "m5"."TagsId" = "m6"."Id"
