      FROM (
          SELECT "p"."Id", "p"."Address", "p"."CreatedAt", "p"."Deposit", "p"."Internet", "p"."IsCurrent", "p"."Latitude", "p"."Longitude", "p"."Name", "p"."ParkingFee", "p"."PetRent", "p"."Rent", "p"."SquareFeet", "p"."UpdatedAt"
          FROM "Properties" AS "p"
          WHERE "p"."Id" = @id
          LIMIT 2
      ) AS "p3"
      LEFT JOIN "PropertyUtilities" AS "p0" ON "p3"."Id" = "p0"."PropertyId"
      LEFT JOIN "PropertyAmenities" AS "p1" ON "p3"."Id" = "p1"."PropertyId"
      LEFT JOIN "PropertyPoints" AS "p2" ON "p3"."Id" = "p2"."PropertyId"
      ORDER BY "p3"."Id", "p0"."Id", "p1"."Id"
