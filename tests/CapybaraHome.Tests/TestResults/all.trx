          SELECT "m5"."MealIngredientId", "m4"."Id", "m5"."Id" AS "Id0", "m4"."MealId"
          FROM "MealVariants" AS "m4"
          INNER JOIN "MealVariantRemovals" AS "m5" ON "m4"."Id" = "m5"."MealVariantId"
      ) AS "s0" ON "m"."Id" = "s0"."MealId" AND "m"."PlannedVariantId" = "s0"."Id"
      WHERE "m"."Status" IN ('Planned', 'PlannedShared')
      ORDER BY "m"."Id", "m0"."Id", "m1"."SortOrder", "m1"."Id", "s"."Id0", "s"."Id", "s0"."Id"
