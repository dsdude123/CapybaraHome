      SELECT "p7"."Id", "p7"."Name", "p7"."Address", "p7"."IsCurrent", "p7"."Rent", "p7"."ParkingFee", "p7"."PetRent", "p7"."Deposit", "p7"."Internet", "p7"."SquareFeet", "p7"."Latitude", "p7"."Longitude", "p0"."Id", "p0"."Kind", "p0"."Label", "p0"."MonthlyCost", "p1"."Id", "p1"."Name", "p1"."SortOrder", "p2"."Id", "p2"."Kind", "p2"."Text", "p2"."SortOrder", "p3"."Id", "p3"."Body", "p3"."CreatedAt", "p4"."Id", "p4"."FileName", "p4"."ContentType", "p4"."ByteCount", "p4"."Caption", "p4"."SortOrder", "p4"."CreatedAt", "s1"."DestinationId", "s1"."Name", "s1"."Minutes", "s1"."Miles", "s1"."TolledRoads", "s1"."Source", "s1"."MeasuredAt", "s1"."Id", "s1"."Id0", "s2"."PriorityId", "s2"."Name", "s2"."Points", "s2"."Meets", "s2"."PropertyId", "s2"."Id", "p7"."CreatedAt", "p7"."UpdatedAt"
      FROM (
          SELECT "p"."Id", "p"."Name", "p"."Address", "p"."IsCurrent", "p"."Rent", "p"."ParkingFee", "p"."PetRent", "p"."Deposit", "p"."Internet", "p"."SquareFeet", "p"."Latitude", "p"."Longitude", "p"."CreatedAt", "p"."UpdatedAt"
          FROM "Properties" AS "p"
          WHERE "p"."Id" = @id
          LIMIT 2
      ) AS "p7"
      LEFT JOIN "PropertyUtilities" AS "p0" ON "p7"."Id" = "p0"."PropertyId"
      LEFT JOIN "PropertyAmenities" AS "p1" ON "p7"."Id" = "p1"."PropertyId"
      LEFT JOIN "PropertyPoints" AS "p2" ON "p7"."Id" = "p2"."PropertyId"
      LEFT JOIN "PropertyNotes" AS "p3" ON "p7"."Id" = "p3"."PropertyId"
      LEFT JOIN "PropertyPhotos" AS "p4" ON "p7"."Id" = "p4"."PropertyId"
      LEFT JOIN (
          SELECT "p5"."DestinationId", "s"."Name", "p5"."Minutes", "p5"."Miles", "p5"."TolledRoads", "p5"."Source", "p5"."MeasuredAt", "p5"."Id", "s"."Id" AS "Id0", "s"."SortOrder", "p5"."PropertyId"
          FROM "PropertyDriveTimes" AS "p5"
          INNER JOIN "SearchDestinations" AS "s" ON "p5"."DestinationId" = "s"."Id"
      ) AS "s1" ON "p7"."Id" = "s1"."PropertyId"
      LEFT JOIN (
          SELECT "p6"."PriorityId", "s0"."Name", "s0"."Points", "p6"."Meets", "p6"."PropertyId", "s0"."Id", "s0"."SortOrder"
          FROM "PropertyPriorities" AS "p6"
          INNER JOIN "SearchPriorities" AS "s0" ON "p6"."PriorityId" = "s0"."Id"
      ) AS "s2" ON "p7"."Id" = "s2"."PropertyId"
      ORDER BY "p7"."Id", "p0"."Kind", "p0"."Id", "p1"."SortOrder", "p1"."Id", "p2"."Kind", "p2"."SortOrder", "p2"."Id", "p3"."Id" DESC, "p4"."SortOrder", "p4"."Id", "s1"."SortOrder", "s1"."DestinationId", "s1"."Id", "s1"."Id0", "s2"."SortOrder", "s2"."PriorityId", "s2"."PropertyId"
