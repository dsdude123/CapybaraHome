      CREATE TABLE "ef_temp_Meals" (
          "Id" INTEGER NOT NULL CONSTRAINT "PK_Meals" PRIMARY KEY AUTOINCREMENT,
          "CreatedAt" TEXT NOT NULL,
          "Directions" TEXT NULL,
          "ImportedText" TEXT NULL,
          "IsOneTime" INTEGER NOT NULL,
          "JiraKey" TEXT NULL,
          "LastCookedAt" TEXT NULL,
          "Name" TEXT NOT NULL,
          "NeedsIngredientSplit" INTEGER NOT NULL,
          "PlannedSlot" TEXT NULL,
          "PlannedVariantId" INTEGER NULL,
          "Status" TEXT NOT NULL,
          "UpdatedAt" TEXT NOT NULL,
          CONSTRAINT "FK_Meals_MealVariants_PlannedVariantId" FOREIGN KEY ("PlannedVariantId") REFERENCES "MealVariants" ("Id") ON DELETE SET NULL
      );
