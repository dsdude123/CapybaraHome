          FROM "MealVariants" AS "m4"
          INNER JOIN "MealVariantRemovals" AS "m5" ON "m4"."Id" = "m5"."MealVariantId"
      ) AS "s0" ON "m"."Id" = "s0"."MealId" AND "m"."PlannedVariantId" = "s0"."Id"
