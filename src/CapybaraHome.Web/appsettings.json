{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CapybaraHome": "Data Source=capybarahome.db"
  },
  "Backups": {
    "Enabled": false,
    "Destination": "backups",
    "Interval": "24:00:00",
    "Keep": 14
  },
  "DataProtection": {
    "KeyPath": ""
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
