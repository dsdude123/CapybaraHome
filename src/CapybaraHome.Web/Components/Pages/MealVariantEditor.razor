@page "/meals/{MealId:int}/variants/new"
@page "/meals/{MealId:int}/variants/{Id:int}"
@inject MealService Meals
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "Add a variant" : "Edit a variant")</PageTitle>

<h1>@(Id is null ? "Add a variant" : "Edit a variant")</h1>

@if (meal is null)
{
    <p class="muted">That meal is gone.</p>
}
else
{
    <p class="muted">A variant of <a href="meals/@meal.Id">@meal.Name</a>. It shares the meal's status and the day it was last cooked.</p>

    <form method="post" @formname="variant-editor" @onsubmit="SubmitAsync">
        <AntiforgeryToken />

        @* The browser submits a form's first submit button when Enter is pressed in a text box, so
           Save goes first and hidden: without it Enter would press a Remove button instead. *@
        <button type="submit" name="action" value="save" hidden></button>

        <div class="field">
            <label for="variant-name">Name</label>
            <input id="variant-name" type="text" name="name" value="@name" />
        </div>

        <div class="field">
            <label for="variant-directions">Directions modifications</label>
            <textarea id="variant-directions" name="directions" rows="8">@directions</textarea>
        </div>

        <IngredientRows Legend="Ingredients added" EmptyText="No ingredients added yet." Rows="rows" />

        <fieldset class="check-list">
            <legend>Ingredients removed</legend>
            @if (meal.Ingredients.Count == 0)
            {
                <p class="muted">The meal has no ingredients to leave out.</p>
            }
            <div class="tag-choices">
            @foreach (var ingredient in meal.Ingredients)
            {
                <label for="variant-remove-@ingredient.Id">
                    <input id="variant-remove-@ingredient.Id" type="checkbox" name="removed" value="@ingredient.Id"
                           checked="@removed.Contains(ingredient.Id)" />
                    @($"{ingredient.Quantity} {ingredient.Item}".Trim())
                </label>
            }
            </div>
        </fieldset>

        @if (error is not null)
        {
            <p class="error">@error</p>
        }

        <div class="row">
            <button class="btn btn-primary" type="submit" name="action" value="save">Save</button>
            <a class="btn" href="meals/@MealId">Cancel</a>
        </div>
    </form>

    @if (Id is not null)
    {
        <form method="post" @formname="variant-delete" @onsubmit="DeleteAsync" style="margin-top:0.75rem">
            <AntiforgeryToken />
            <button class="btn btn-danger" type="submit">Delete</button>
        </form>
    }
}

@code {
    /// <summary>Id of the meal the variant belongs to.</summary>
    [Parameter]
    public int MealId { get; set; }

    /// <summary>Id of the variant being edited, or null when adding one.</summary>
    [Parameter]
    public int? Id { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private MealView? meal;
    private List<IngredientRow> rows = [];
    private List<int> removed = [];
    private string? name;
    private string? directions;
    private string? error;

    /// <summary>Loads the meal and fills the editor, from the posted form when there is one.</summary>
    protected override async Task OnParametersSetAsync()
    {
        meal = await Meals.GetAsync(MealId);
        if (meal is null)
        {
            return;
        }

        if (HttpContext?.Request.Method == HttpMethods.Post)
        {
            ReadForm(HttpContext.Request.Form);
            return;
        }

        var variant = Id is { } id ? meal.Variants.SingleOrDefault(v => v.Id == id) : null;
        if (Id is not null && variant is null)
        {
            Navigation.NavigateTo($"meals/{MealId}");
            return;
        }

        name = variant?.Name;
        directions = variant?.DirectionsModifications;
        removed = variant?.RemovedIngredientIds.ToList() ?? [];
        // A fresh variant has nowhere to type without a line, so it starts with one empty one.
        rows = variant is null
            ? [new IngredientRow(null, null)]
            : variant.AddedIngredients.Select(i => new IngredientRow(i.Quantity, i.Item)).ToList();
    }

    private async Task SubmitAsync()
    {
        if (HttpContext is null)
        {
            return;
        }

        var action = HttpContext.Request.Form["action"].ToString();

        if (action == "add-row")
        {
            rows.Add(new IngredientRow(null, null));
            return;
        }

        if (IngredientRow.RemovedIndex(action) is { } index)
        {
            if (index >= 0 && index < rows.Count)
            {
                rows.RemoveAt(index);
            }

            return;
        }

        error = null;

        var added = rows
            .Where(row => !string.IsNullOrWhiteSpace(row.Item))
            .Select(row => new MealIngredientInput(row.Item!, row.Quantity))
            .ToList();

        var request = new MealVariantRequest(name ?? string.Empty, directions, added, removed);

        try
        {
            if (Id is null)
            {
                await Meals.CreateVariantAsync(MealId, request);
            }
            else
            {
                await Meals.UpdateVariantAsync(Id.Value, request);
            }

            Navigation.NavigateTo($"meals/{MealId}");
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }
    }

    private async Task DeleteAsync()
    {
        if (Id is not null)
        {
            await Meals.DeleteVariantAsync(Id.Value);
        }

        Navigation.NavigateTo($"meals/{MealId}");
    }

    private void ReadForm(IFormCollection form)
    {
        name = form["name"];
        directions = form["directions"];

        removed = form["removed"]
            .Select(value => int.TryParse(value, out var id) ? id : 0)
            .Where(id => id > 0)
            .ToList();

        rows = IngredientRow.ReadFrom(form);
    }
}
