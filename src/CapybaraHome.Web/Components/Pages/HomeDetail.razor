@page "/homes/{Id:int}"
@using CapybaraHome.Domain.Homes
@inject PropertyService Properties
@inject HomeSearchService Search
@inject HomeSearchBoardService Board
@inject DriveTimeMeasurer Measurer
@inject PropertyPhotoService Photos
@inject PropertyAttachmentService Attachments
@inject PropertyTourService Tours
@inject NavigationManager Navigation

<PageTitle>@(property?.Name ?? "Property")</PageTitle>

@if (property is null)
{
    <p class="muted">That property is not here.</p>
}
else
{
    <div class="page-head">
        <h1>
            @property.Name
            @if (property.IsCurrent)
            {
                <span class="pill">Where I live now</span>
            }
        </h1>
        <div class="row">
            <a class="btn btn-small" href="homes">All properties</a>
            @if (!property.IsCurrent)
            {
                <a class="btn btn-small" href="homes/@Id/tour">Start tour</a>
            }
            <a class="btn btn-primary btn-small" href="homes/@Id/edit">Edit</a>
        </div>
    </div>

    @foreach (var tour in tours)
    {
        var submitted = DateNames.LongWithTime(tour.SubmittedAt, TimeZoneInfo.Local);

        @if (tour.Status == PropertyTourStatus.Processing)
        {
            <p class="notice" role="status">
                The tour submitted on @submitted is being processed. This can take a long while;
                reload the page to see whether it has finished.
            </p>
        }
        else
        {
            <div class="notice stack" role="alert">
                <p class="error">Processing the tour submitted on @submitted failed. @tour.Error</p>
                <div class="row">
                    <form method="post" @formname="@($"tour-retry-{tour.Id}")" @onsubmit="() => RetryTourAsync(tour.Id)">
                        <AntiforgeryToken />
                        <button class="btn btn-primary btn-small" type="submit">Retry</button>
                    </form>
                    <form method="post" @formname="@($"tour-dismiss-{tour.Id}")" @onsubmit="() => DismissTourAsync(tour.Id)">
                        <AntiforgeryToken />
                        <button class="btn btn-small" type="submit">Dismiss</button>
                    </form>
                </div>
            </div>
        }
    }

    @if (property.Address is { Length: > 0 })
    {
        <p class="muted">@property.Address</p>
    }

    <p class="muted">Size: @Size(property)</p>

    <section class="card stack">
        <h2 class="card-title">Score</h2>
        @if (!settings.AnyWeightSet && priorityPoints == 0m)
        {
            <p class="notice">
                No scoring weights are set yet, so everything scores zero.
                <a href="homes/settings">Set the weights</a>.
            </p>
        }
        <p class="metric">@Points(score!.Total)</p>
        <table>
            <thead>
                <tr><th scope="col">What</th><th scope="col">Difference</th><th scope="col">Points</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td>Fees a month</td>
                    <td>@Money(score.MonthlyDifference)</td>
                    <td>@Points(score.MonthlyFees)</td>
                </tr>
                <tr>
                    <td>Deposit</td>
                    <td>@Money(score.DepositDifference)</td>
                    <td>@Points(score.Deposit)</td>
                </tr>
                <tr>
                    <td>Driving a month</td>
                    <td>@Money(score.DrivingDifference)</td>
                    <td>@Points(score.Driving)</td>
                </tr>
                <tr>
                    <td>Size</td>
                    <td>@SizeDifference(score.SizeDifference)</td>
                    <td>@Points(score.Size)</td>
                </tr>
                @foreach (var line in score.DriveTimeLines)
                {
                    <tr>
                        <td>Drive to @line.Name</td>
                        <td>@Difference(line)</td>
                        <td>@Points(line.Points)</td>
                    </tr>
                }
                <tr>
                    <td>Amenities</td>
                    <td>@property.Amenities.Count</td>
                    <td>@Points(score.Amenities)</td>
                </tr>
                <tr>
                    <td>Pros</td>
                    <td>@property.Pros.Count()</td>
                    <td>@Points(score.Pros)</td>
                </tr>
                <tr>
                    <td>Cons</td>
                    <td>@property.Cons.Count()</td>
                    <td>@Points(score.Cons)</td>
                </tr>
                <tr>
                    <td>Priorities met</td>
                    <td>@property.Priorities.Count(p => p.Meets == true) of @priorities.Count</td>
                    <td>@Points(score.Priorities)</td>
                </tr>
            </tbody>
        </table>
        @if (property.IsCurrent)
        {
            <p class="muted">
                This is the baseline, so its fees, size and drives are not compared with anything.
            </p>
        }
        else if (current is null)
        {
            <p class="muted">
                No home is marked as the one you live in, so there is nothing to compare the fees
                and the drives against.
            </p>
        }
    </section>

    <section class="card stack">
        <h2 class="card-title">What it costs</h2>
        <table>
            <tbody>
                <tr><td>Rent</td><td>@Money(property.Rent)</td></tr>
                <tr><td>Parking</td><td>@Money(property.ParkingFee)</td></tr>
                <tr><td>Cat rent</td><td>@Money(property.PetRent)</td></tr>
                @foreach (var utility in property.Utilities)
                {
                    <tr>
                        <td>@UtilityKindNames.Label(utility.Kind, utility.Label)</td>
                        <td>@Money(utility.MonthlyCost)</td>
                    </tr>
                }
                <tr><td><strong>A month in all</strong></td><td><strong>@Money(property.MonthlyTotal)</strong></td></tr>
                <tr><td>Deposit, once</td><td>@Money(property.Deposit)</td></tr>
            </tbody>
        </table>
        <p class="muted">Internet: @(property.Internet is { Length: > 0 } ? property.Internet : "not recorded")</p>
        <p class="muted">
            Listing:
            @if (property.ListingUrl is { Length: > 0 } listing)
            {
                <a href="@listing" target="_blank" rel="noopener noreferrer">@listing</a>
            }
            else
            {
                @("no link")
            }
        </p>
    </section>

    <div class="card-grid">
        <section class="card stack">
            <h2 class="card-title">Amenities</h2>
            @if (property.Amenities.Count == 0)
            {
                <p class="muted">None recorded.</p>
            }
            else
            {
                <ul class="print-list">
                    @foreach (var amenity in property.Amenities)
                    {
                        <li>@amenity.Name</li>
                    }
                </ul>
            }
        </section>

        <section class="card stack">
            <h2 class="card-title">Pros</h2>
            @if (!property.Pros.Any())
            {
                <p class="muted">None recorded.</p>
            }
            else
            {
                <ul class="print-list">
                    @foreach (var pro in property.Pros)
                    {
                        <li>@pro.Text</li>
                    }
                </ul>
            }
        </section>

        <section class="card stack">
            <h2 class="card-title">Cons</h2>
            @if (!property.Cons.Any())
            {
                <p class="muted">None recorded.</p>
            }
            else
            {
                <ul class="print-list">
                    @foreach (var con in property.Cons)
                    {
                        <li>@con.Text</li>
                    }
                </ul>
            }
        </section>
    </div>

    <section class="card stack">
        <h2 class="card-title">Priorities</h2>
        @if (priorities.Count == 0)
        {
            <p class="muted">
                No priorities yet. <a href="homes/settings">Add some</a> and they appear here to mark.
            </p>
        }
        else
        {
            <form method="post" @formname="property-priorities" @onsubmit="SavePrioritiesAsync" class="stack">
                <AntiforgeryToken />
                @foreach (var priority in priorities)
                {
                    var held = property.Priorities.FirstOrDefault(p => p.PriorityId == priority.Id);
                    <div class="choice-line">
                        <label for="priority-@priority.Id">@priority.Name <span class="muted">@Points(priority.Points)</span></label>
                        <select id="priority-@priority.Id" name="priority-@priority.Id">
                            @foreach (var choice in PriorityMarks.All)
                            {
                                <option value="@PriorityMarks.Value(choice)" selected="@(held?.Meets == choice)">
                                    @PriorityMarks.Label(choice)
                                </option>
                            }
                        </select>
                    </div>
                }
                <div class="row">
                    <button class="btn btn-primary btn-small" type="submit">Save the markings</button>
                </div>
            </form>
        }
    </section>

    <section class="card stack">
        <h2 class="card-title">Drive times</h2>
        @if (destinations.Count == 0)
        {
            <p class="muted">
                No destinations yet. <a href="homes/settings">Add work and anywhere else</a> you drive to.
            </p>
        }
        else
        {
            <form method="post" @formname="property-drives" @onsubmit="SaveDrivesAsync" class="stack">
                <AntiforgeryToken />
                @foreach (var destination in destinations)
                {
                    var held = property.DriveTimes.FirstOrDefault(d => d.DestinationId == destination.Id);
                    <p class="task-meta">
                        <strong>@destination.Name</strong>
                        @if (held is not null)
                        {
                            <span class="muted">— @(held.Source == DriveTimeSource.Measured ? "measured" : "typed in")</span>
                        }
                        @if (held is { IsAdjusted: true })
                        {
                            <span class="muted">
                                — @Minutes(held.Minutes) @Factor(destination.DriveTimeMultiplier)
                                = @Minutes(held.AdjustedMinutes) counted
                            </span>
                        }
                    </p>
                    <div class="filters">
                        <div class="field">
                            <label for="drive-@destination.Id">Minutes</label>
                            <input id="drive-@destination.Id" type="number" step="0.1" min="0" name="drive-@destination.Id"
                                   value="@Typed(held?.Minutes)" />
                        </div>
                        <div class="field">
                            <label for="miles-@destination.Id">Miles, one way</label>
                            <input id="miles-@destination.Id" type="number" step="0.1" min="0" name="miles-@destination.Id"
                                   value="@Typed(held?.Miles)" />
                        </div>
                    </div>
                    @if (held is { TolledRoads.Count: > 0 })
                    {
                        <p class="task-meta">Tolled roads on the route: @string.Join(", ", held.TolledRoads)</p>
                    }
                    @if (tollRoads.Count > 0)
                    {
                        <div class="choice-line">
                            <span class="muted">Charge these toll roads</span>
                            @foreach (var toll in tollRoads)
                            {
                                <label for="toll-@destination.Id-@toll.Id">
                                    <input id="toll-@destination.Id-@toll.Id" type="checkbox"
                                           name="toll-@destination.Id" value="@toll.Id"
                                           checked="@Charged(held, toll)" />
                                    @toll.Road
                                </label>
                            }
                        </div>
                        <p class="task-meta muted">
                            @(held?.TollRoadOverrideIds is null
                                ? "Ticked from the measured route. Tick one the route missed and that choice stands instead, measure or no measure."
                                : "Marked by hand, so the measured route no longer decides. Match the ticks to the route to hand it back.")
                        </p>
                    }
                    <div class="filters">
                        <div class="field">
                            <label for="parking-@destination.Id">Parking a day, here</label>
                            <input id="parking-@destination.Id" type="number" step="0.01" min="0" name="parking-@destination.Id"
                                   value="@Fee(held?.ParkingPerDayOverride)" placeholder="@Fee(destination.ParkingPerDay)" />
                        </div>
                        <div class="field">
                            <label for="commute-@destination.Id">Commute credit a day, here</label>
                            <input id="commute-@destination.Id" type="number" step="0.01" min="0" name="commute-@destination.Id"
                                   value="@Fee(held?.CommuteCreditPerDayOverride)" placeholder="@Fee(destination.CommuteCreditPerDay)" />
                        </div>
                    </div>
                    <p class="task-meta muted">
                        @(held is { HasFeeOverride: true }
                            ? "This drive charges its own, whatever the destination charges. Empty the boxes to follow it again."
                            : "Left empty, this drive follows the destination. Fill one in where this commute works differently, such as transit being there to take.")
                    </p>
                }
                <div class="row">
                    <button class="btn btn-primary btn-small" type="submit">Save the times</button>
                </div>
            </form>

            <form method="post" @formname="property-measure" @onsubmit="MeasureAsync">
                <AntiforgeryToken />
                <div class="row">
                    <button class="btn btn-small" type="submit" disabled="@(!settings.CanMeasureDriveTimes)">
                        Measure them from the address
                    </button>
                </div>
            </form>

            @if (!settings.CanMeasureDriveTimes)
            {
                <p class="muted">
                    Measuring needs a routing service. <a href="homes/settings">Set one up</a>, or type the
                    minutes in above.
                </p>
            }

            @if (measured is not null)
            {
                <p class="notice">@measured</p>
            }

            @foreach (var problem in problems)
            {
                <p class="error">@problem</p>
            }
        }
    </section>

    <section class="card stack">
        <h2 class="card-title">Driving cost</h2>
        @if (!driving!.AnyDriving)
        {
            <p class="muted">
                Nothing to cost yet. This counts the round trips a week set on each
                <a href="homes/settings">destination</a> — three for a three-day work week — against
                the miles, the tolls and the parking of each drive, less any commute credit.
            </p>
        }
        else
        {
            <div class="table-wide">
            <table>
                <thead>
                    <tr>
                        <th scope="col">Drive</th>
                        <th scope="col">Miles a week</th>
                        <th scope="col">Fuel a week</th>
                        <th scope="col">Tolls a week</th>
                        <th scope="col">Parking a week</th>
                        <th scope="col">Commute credit</th>
                        <th scope="col">A week</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in driving.Lines)
                    {
                        <tr>
                            <td>
                                @line.Name
                                <br /><span class="muted">@Trips(line.RoundTripsPerWeek) × @Miles(line.Miles) each way</span>
                                @if (line.HasFeeOverride)
                                {
                                    <br /><span class="muted">its own parking or credit</span>
                                }
                            </td>
                            <td>@Miles(line.MilesPerWeek)</td>
                            <td>
                                @Cents(line.FuelPerWeek)
                                <br /><span class="muted">@Cars(line)</span>
                            </td>
                            <td>
                                @Cents(line.TollsPerWeek)
                                @if (line.Tolls.Count > 0)
                                {
                                    <br /><span class="muted">@string.Join(", ", line.Tolls.Select(t => t.Road))</span>
                                }
                            </td>
                            <td>@Cents(line.ParkingPerWeek)</td>
                            <td>@Credit(line.CommuteCreditPerWeek)</td>
                            <td>@Cents(line.WeeklyCost)</td>
                        </tr>
                    }
                    <tr>
                        <td><strong>A week in all</strong></td>
                        <td><strong>@Miles(driving.MilesPerWeek)</strong></td>
                        <td><strong>@Cents(driving.FuelPerWeek)</strong></td>
                        <td><strong>@Cents(driving.TollsPerWeek)</strong></td>
                        <td><strong>@Cents(driving.ParkingPerWeek)</strong></td>
                        <td><strong>@Credit(driving.CommuteCreditPerWeek)</strong></td>
                        <td><strong>@Cents(driving.WeeklyCost)</strong></td>
                    </tr>
                </tbody>
            </table>
            </div>

            <p class="muted">
                A week is the fuel, the tolls and the parking, less the commute credit:
                @Cents(driving.WeeklyCost) a week, @Cents(driving.MonthlyCost) a month, over
                @Gallons(driving.GallonsPerWeek) gal. The fees less the credit are
                @Cents(driving.FeesLessCreditPerWeek) of the week, @Cents(driving.MonthlyFeesLessCredit)
                of the month, whichever car it is driven in.
            </p>

            @if (vehicles.Count == 0)
            {
                <p class="muted">
                    No cars yet. <a href="homes/settings">Add one with its average mpg and what a
                    gallon costs</a> and the fuel is costed here too.
                </p>
            }
            @foreach (var name in driving.MissingCars)
            {
                <p class="muted">
                    The drive to @name has no car with both a mileage and a fuel price, so its fuel
                    is not counted. <a href="homes/settings">Set its car</a>, or fill in the mpg and
                    the fuel price.
                </p>
            }
        }

        @foreach (var name in driving!.MissingMiles)
        {
            <p class="muted">
                The drive to @name has no distance yet, so its fuel is not counted. Measure it or type
                the miles in beside the minutes above.
            </p>
        }

        @foreach (var line in driving.Lines.Where(l => l.UnpricedTolledRoads.Count > 0))
        {
            <p class="notice">
                The drive to @line.Name uses a tolled road nothing prices yet:
                @string.Join(", ", line.UnpricedTolledRoads).
                <a href="homes/settings">Add it as a toll road</a> to count it.
            </p>
        }
    </section>

    <section class="card stack">
        <h2 class="card-title">Notes</h2>
        <form method="post" @formname="property-note" @onsubmit="AddNoteAsync" class="stack">
            <AntiforgeryToken />
            <div class="field">
                <label for="note-body">A new note</label>
                <textarea id="note-body" name="body" rows="3">@noteBody</textarea>
            </div>
            <div class="row">
                <button class="btn btn-primary btn-small" type="submit">Add the note</button>
            </div>
        </form>

        @if (noteError is not null)
        {
            <p class="error">@noteError</p>
        }

        @if (property.Notes.Count == 0)
        {
            <p class="muted">No notes yet.</p>
        }
        else
        {
            <ul class="task-list">
                @foreach (var note in property.Notes)
                {
                    <li>
                        <div class="task-line">
                            <span class="directions">@note.Body</span>
                            <form method="post" @formname="@($"note-delete-{note.Id}")" @onsubmit="() => DeleteNoteAsync(note.Id)">
                                <AntiforgeryToken />
                                <button class="btn btn-small btn-danger" type="submit"
                                        aria-label="@($"Delete the note from {DateNames.Day(note.CreatedAt)}")">Delete</button>
                            </form>
                        </div>
                        <p class="task-meta">@DateNames.Day(note.CreatedAt)</p>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="card stack">
        <h2 class="card-title">Pictures</h2>
        <form method="post" action="homes/@Id/photos" enctype="multipart/form-data" class="stack">
            <AntiforgeryToken />
            <div class="field">
                <label for="photo-file">A picture</label>
                <input id="photo-file" type="file" name="file" accept="image/jpeg,image/png,image/gif,image/webp" required />
            </div>
            <div class="field">
                <label for="photo-caption">What it shows</label>
                <input id="photo-caption" type="text" name="caption" />
            </div>
            <div class="row">
                <button class="btn btn-primary btn-small" type="submit">Upload it</button>
            </div>
        </form>

        @if (Photo is { Length: > 0 })
        {
            <p class="notice">@Photo</p>
        }

        @if (PhotoError is { Length: > 0 })
        {
            <p class="error">@PhotoError</p>
        }

        @if (property.Photos.Count == 0)
        {
            <p class="muted">No pictures yet.</p>
        }
        else
        {
            <div class="photo-grid">
                @foreach (var photo in property.Photos)
                {
                    <figure class="photo">
                        <a href="homes/photos/@photo.Id">
                            <img src="homes/photos/@photo.Id" alt="@(photo.Caption ?? photo.FileName)" loading="lazy" />
                        </a>
                        <figcaption>
                            @(photo.Caption ?? photo.FileName)
                            <form method="post" @formname="@($"photo-delete-{photo.Id}")" @onsubmit="() => DeletePhotoAsync(photo.Id)">
                                <AntiforgeryToken />
                                <button class="btn btn-small btn-danger" type="submit"
                                        aria-label="@($"Delete {photo.FileName}")">Delete</button>
                            </form>
                        </figcaption>
                    </figure>
                }
            </div>
        }
    </section>

    <section class="card stack">
        <h2 class="card-title">Attachments</h2>
        @if (attachments.Count == 0)
        {
            <p class="muted">No attachments yet. A tour's notes and video are kept here.</p>
        }
        else
        {
            <ul class="task-list">
                @foreach (var attachment in attachments)
                {
                    <li>
                        <div class="task-line">
                            <a href="homes/attachments/@attachment.Id">@attachment.FileName</a>
                            <form method="post" @formname="@($"attachment-delete-{attachment.Id}")" @onsubmit="() => DeleteAttachmentAsync(attachment.Id)">
                                <AntiforgeryToken />
                                <button class="btn btn-small btn-danger" type="submit"
                                        aria-label="@($"Delete {attachment.FileName}")">Delete</button>
                            </form>
                        </div>
                        <p class="task-meta">@FileSizes.Label(attachment.ByteCount), @DateNames.Day(attachment.CreatedAt)</p>
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    /// <summary>Id of the property being looked at.</summary>
    [Parameter]
    public int Id { get; set; }

    /// <summary>What an upload said, carried back from the endpoint that handled the file.</summary>
    [SupplyParameterFromQuery(Name = "photo")]
    private string? Photo { get; set; }

    /// <summary>Why an upload was refused, carried back from the endpoint that handled the file.</summary>
    [SupplyParameterFromQuery(Name = "photoError")]
    private string? PhotoError { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private PropertyView? property;
    private PropertyView? current;
    private PropertyScore? score;
    private IReadOnlyList<SearchDestinationView> destinations = [];
    private IReadOnlyList<SearchPriorityView> priorities = [];
    private IReadOnlyList<VehicleView> vehicles = [];
    private IReadOnlyList<TollRoadView> tollRoads = [];
    private IReadOnlyList<PropertyAttachmentView> attachments = [];
    private IReadOnlyList<PropertyTourView> tours = [];
    private PropertyDrivingCost? driving;
    private HomeSearchSettingsView settings = new(0m, 0m, 0m, 0m, 0m, 0m, 0m, null, false);
    private decimal priorityPoints;
    private List<string> problems = [];
    private string? measured;
    private string? noteBody;
    private string? noteError;

    /// <summary>Loads the property and everything shown beside it.</summary>
    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var scored = await Board.GetScoredAsync(Id);
        property = scored?.Property;
        score = scored?.Score;
        driving = scored?.Driving;

        if (property is null)
        {
            return;
        }

        current = await Properties.GetCurrentAsync();
        destinations = await Search.ListDestinationsAsync();
        priorities = await Search.ListPrioritiesAsync();
        vehicles = await Search.ListVehiclesAsync();
        tollRoads = await Search.ListTollRoadsAsync();
        settings = await Search.GetSettingsAsync();
        priorityPoints = priorities.Sum(p => Math.Abs(p.Points));
        attachments = await Attachments.ListAsync(Id);
        tours = await Tours.ListOpenAsync(Id);
    }

    // Each of these goes back to the page with a redirect: the alert says to reload, and a reload
    // straight after a post would send it again to a form that is no longer on the page.
    private async Task RetryTourAsync(int tourId)
    {
        await Tours.RetryAsync(tourId);
        Navigation.NavigateTo($"homes/{Id}");
    }

    private async Task DismissTourAsync(int tourId)
    {
        await Tours.DismissAsync(tourId);
        Navigation.NavigateTo($"homes/{Id}");
    }

    private async Task DeleteAttachmentAsync(int attachmentId)
    {
        await Attachments.DeleteAsync(attachmentId);
        Navigation.NavigateTo($"homes/{Id}");
    }

    private async Task SavePrioritiesAsync()
    {
        if (HttpContext is null)
        {
            return;
        }

        foreach (var priority in priorities)
        {
            var posted = HttpContext.Request.Form[$"priority-{priority.Id}"].ToString();
            await Properties.MarkPriorityAsync(Id, priority.Id, PriorityMarks.Parse(posted));
        }

        await LoadAsync();
    }

    private async Task SaveDrivesAsync()
    {
        if (HttpContext is null)
        {
            return;
        }

        foreach (var destination in destinations)
        {
            var posted = HttpContext.Request.Form[$"drive-{destination.Id}"].ToString();

            if (double.TryParse(posted, System.Globalization.CultureInfo.InvariantCulture, out var minutes) && minutes >= 0)
            {
                var postedMiles = HttpContext.Request.Form[$"miles-{destination.Id}"].ToString();
                var miles = double.TryParse(postedMiles, System.Globalization.CultureInfo.InvariantCulture, out var typed) && typed >= 0
                    ? typed
                    : (double?)null;

                var held = property!.DriveTimes.FirstOrDefault(d => d.DestinationId == destination.Id);

                // Leaving the numbers as they are and ticking a toll road does not turn a measured
                // drive into a typed one, which would take its multiplier off as well.
                var source = held is not null && Same(held.Minutes, minutes) && Same(held.Miles, miles)
                    ? held.Source
                    : DriveTimeSource.Manual;

                // Tolls come from the measured route, so retyping the time keeps the ones it found.
                await Properties.SetDriveTimeAsync(
                    Id, destination.Id, minutes, miles, source, held?.TolledRoads, Marked(held, destination.Id),
                    Fees(destination.Id));
            }
            else
            {
                await Properties.ClearDriveTimeAsync(Id, destination.Id);
            }
        }

        await LoadAsync();
    }

    private async Task MeasureAsync()
    {
        try
        {
            var outcome = await Measurer.MeasureAsync(Id);
            if (outcome is not null)
            {
                measured = $"Measured {outcome.Measured} drive(s).";
                problems = outcome.Problems.ToList();
            }
        }
        catch (RoutingException ex)
        {
            problems = [ex.Message];
        }

        await LoadAsync();
    }

    private async Task AddNoteAsync()
    {
        noteBody = HttpContext?.Request.Form["body"];

        try
        {
            await Properties.AddNoteAsync(Id, noteBody ?? string.Empty);
            noteBody = null;
            noteError = null;
        }
        catch (ArgumentException ex)
        {
            noteError = ex.Message;
        }

        await LoadAsync();
    }

    private async Task DeleteNoteAsync(int noteId)
    {
        await Properties.DeleteNoteAsync(noteId);
        await LoadAsync();
    }

    private async Task DeletePhotoAsync(int photoId)
    {
        await Photos.DeleteAsync(photoId);
        Navigation.NavigateTo($"homes/{Id}");
    }

    // The container has no locale, so a currency format renders the generic sign rather than a
    // dollar one; the weights are labelled per dollar, so the sign is written out here.
    private static string Money(decimal? value) =>
        value is null
            ? "\u2014"
            : (value < 0 ? "\u2212$" : "$") + Math.Abs(value.Value).ToString("N0", System.Globalization.CultureInfo.InvariantCulture);

    private static string Cents(decimal value) =>
        (value < 0 ? "\u2212$" : "$") + Math.Abs(value).ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

    // A credit is money back, so it is written as the amount taken off rather than as a negative
    // cost, and the column beside it carries the tolls with the credit already off.
    private static string Credit(decimal value) =>
        value == 0m ? "\u2014" : Cents(value) + " off";

    private static string Miles(double? value) =>
        value is null
            ? "\u2014"
            : value.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + " mi";

    private static string Trips(decimal value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // Named where one car is charged, counted where the fuel is shared out over several.
    private static string Cars(DrivingCostLine line) => line.Cars.Count switch
    {
        0 => "no car costed",
        1 => line.Cars[0],
        var count => $"averaged over {count} cars",
    };

    private static string Gallons(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string SquareFeet(int? size) =>
        size is { } known
            ? known.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) + " sq ft"
            : "not recorded";

    private static string Size(PropertyView property) =>
        SquareFeet(property.SquareFeet)
        + (property.RentPerSquareFoot is { } perFoot ? $", {Cents(perFoot)} rent a sq ft" : string.Empty);

    private static string SizeDifference(int? difference) =>
        difference is { } known
            ? (known > 0 ? "+" : known < 0 ? "\u2212" : string.Empty)
                + Math.Abs(known).ToString("N0", System.Globalization.CultureInfo.InvariantCulture) + " sq ft"
            : "\u2014";

    // Which toll roads the drive is charged: the ones marked by hand, or the ones the measured
    // route named.
    private bool Charged(PropertyDriveTimeView? held, TollRoadView toll) =>
        held?.TollRoadOverrideIds is { } chosen
            ? chosen.Contains(toll.Id)
            : held is not null && held.TolledRoads.Any(toll.Prices);

    // Ticks matching the route exactly leave the route in charge, so a later measurement still
    // counts; anything else is his own mark and stands.
    private IReadOnlyList<int>? Marked(PropertyDriveTimeView? held, int destinationId)
    {
        if (tollRoads.Count == 0 || HttpContext is null)
        {
            return held?.TollRoadOverrideIds;
        }

        var ticked = HttpContext.Request.Form[$"toll-{destinationId}"]
            .Select(value => int.TryParse(value, out var id) ? id : 0)
            .Where(id => tollRoads.Any(toll => toll.Id == id))
            .Distinct()
            .Order()
            .ToList();

        var fromRoute = tollRoads
            .Where(toll => held is not null && held.TolledRoads.Any(toll.Prices))
            .Select(toll => toll.Id)
            .Order()
            .ToList();

        return ticked.SequenceEqual(fromRoute) ? null : ticked;
    }

    // An empty box leaves the drive on the destination's fee rather than charging it nothing,
    // which is the difference between "the same as everywhere" and "free here".
    private DriveFeeOverrides Fees(int destinationId) =>
        new(Money($"parking-{destinationId}"), Money($"commute-{destinationId}"));

    private decimal? Money(string field)
    {
        var posted = HttpContext?.Request.Form[field].ToString();

        return decimal.TryParse(posted, System.Globalization.CultureInfo.InvariantCulture, out var value) && value >= 0m
            ? value
            : null;
    }

    private static string? Fee(decimal? value) =>
        value?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static bool Same(double? held, double? posted) =>
        held is null
            ? posted is null
            : posted is not null && Math.Abs(held.Value - posted.Value) < 0.005d;

    private static string Minutes(double value) =>
        value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + " min";

    private static string Factor(double value) =>
        "\u00d7" + value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string Points(decimal value) =>
        (value > 0 ? "+" : string.Empty) + value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string? Typed(double? minutes) =>
        minutes?.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static string Difference(DriveTimeScore line) =>
        line.Minutes is { } mine && line.CurrentMinutes is { } theirs
            ? $"{Typed(mine)} min against {Typed(theirs)} min"
            : line.Minutes is { } only
                ? $"{Typed(only)} min, nothing to compare"
                : "not known";
}
