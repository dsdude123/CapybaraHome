@page "/tasks/new"
@page "/tasks/{Id:int}"
@inject TaskService Tasks
@inject TaskCloseOperationService CloseOperations
@inject CategoryService Categories
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "Create a task" : "Edit a task")</PageTitle>

<h1>@(Id is null ? "Create a task" : "Edit a task")</h1>

<EditForm Model="form" FormName="task-editor" OnValidSubmit="SaveAsync">

    <div class="field">
        <label for="task-title">Title</label>
        <InputText id="task-title" type="text" @bind-Value="form.Title" />
    </div>

    <div class="field">
        <label for="task-notes">Description</label>
        <InputTextArea id="task-notes" @bind-Value="form.Notes" />
    </div>

    <div class="filters">
        <div class="field">
            <label for="task-status">Status</label>
            <InputSelect id="task-status" @bind-Value="form.Status">
                @foreach (var value in StatusNames.All)
                {
                    <option value="@value">@StatusNames.Label(value)</option>
                }
            </InputSelect>
        </div>

        <div class="field">
            <label for="task-category">Category</label>
            <InputSelect id="task-category" @bind-Value="form.CategoryId">
                <option value="">Uncategorized</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </InputSelect>
        </div>

        <div class="field">
            <label for="task-due">Due date</label>
            <InputDate id="task-due" @bind-Value="form.DueDate" />
        </div>
    </div>

    @if (error is not null)
    {
        <p class="error">@error</p>
    }

    <div class="row">
        <button class="btn btn-primary" type="submit">Save</button>
        <a class="btn" href="tasks">Cancel</a>
    </div>
</EditForm>

@if (Id is not null)
{
    <div class="card" style="margin:0.75rem 0">
        <div class="card-head">
            <h2 class="card-title">When this task is done</h2>
            <a class="btn btn-small" href="@($"tasks/{Id}/operations/new")">Add an operation</a>
        </div>

        @if (operations.Count == 0)
        {
            <p class="muted">Nothing happens beyond the task being marked done.</p>
        }
        else
        {
            <ul class="task-list">
                @foreach (var operation in operations)
                {
                    <li>
                        <div class="task-line">
                            <a class="task-link" href="@($"tasks/{Id}/operations/{operation.Id}")">@CloseOperationNames.Label(operation.Kind)</a>
                            @if (!operation.IsEnabled)
                            {
                                <span class="pill">Paused</span>
                            }
                            <form method="post" class="inline-form" @formname="@($"operation-delete-{operation.Id}")" @onsubmit="() => RemoveOperationAsync(operation.Id)">
                                <AntiforgeryToken />
                                <button class="btn btn-small btn-danger" type="submit">Remove</button>
                            </form>
                        </div>
                        <div class="task-meta">
                            <span>@Summary(operation)</span>
                            @if (operation.LastRun is { } run)
                            {
                                <span>Last run @RunLine(run)</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </div>

    <form method="post" @formname="task-delete" @onsubmit="DeleteAsync" style="margin-top:0.75rem">
        <AntiforgeryToken />
        <button class="btn btn-danger" type="submit">Delete</button>
    </form>
}

@code {
    /// <summary>Id of the task being edited, or null when creating one.</summary>
    [Parameter]
    public int? Id { get; set; }

    [SupplyParameterFromForm(Name = "form")]
    private TaskForm? postedForm { get; set; }

    private TaskForm form = new();
    private IReadOnlyList<CategoryView> categories = [];
    private IReadOnlyList<TaskCloseOperationView> operations = [];
    private string? error;

    /// <summary>Loads the categories and, when editing, fills the form from the task.</summary>
    protected override async Task OnParametersSetAsync()
    {
        categories = await Categories.ListAsync();
        operations = Id is null ? [] : await CloseOperations.ListAsync(Id.Value);

        // A post carries the edited values; anything else means the form is being opened fresh.
        if (postedForm is not null)
        {
            form = postedForm;
            return;
        }

        if (Id is null)
        {
            form = new TaskForm();
            return;
        }

        var task = await Tasks.GetAsync(Id.Value);
        if (task is null)
        {
            Navigation.NavigateTo("tasks");
            return;
        }

        form = new TaskForm
        {
            Title = task.Title,
            Notes = task.Notes ?? string.Empty,
            Status = task.Status,
            CategoryId = task.CategoryId?.ToString() ?? string.Empty,
            DueDate = task.DueDate?.ToDateTime(TimeOnly.MinValue),
        };
    }

    private async Task SaveAsync()
    {
        error = null;
        var category = int.TryParse(form.CategoryId, out var parsed) ? parsed : (int?)null;
        var due = form.DueDate is { } value ? DateOnly.FromDateTime(value) : (DateOnly?)null;

        try
        {
            if (Id is null)
            {
                var created = await Tasks.CreateAsync(
                    new CreateTaskRequest(form.Title ?? string.Empty, form.Notes, form.Status, category, due));
                Navigation.NavigateTo($"tasks/{created.Id}");
                return;
            }

            await Tasks.UpdateAsync(Id.Value, new UpdateTaskRequest(
                Title: form.Title,
                Notes: form.Notes,
                Status: form.Status,
                CategoryId: category,
                ClearCategory: category is null,
                DueDate: due,
                ClearDueDate: due is null));

            Navigation.NavigateTo("tasks");
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }
    }

    /// <summary>Returns what the operation's last run says, with its detail when it has one.</summary>
    private static string RunLine(TaskCloseRunView run)
    {
        var status = CloseOperationNames.Label(run.Status).ToLowerInvariant();
        return run.Detail is { Length: > 0 } detail ? $"{status}: {detail}" : status;
    }

    /// <summary>Returns the line that says what an operation will do.</summary>
    private string Summary(TaskCloseOperationView operation) => operation.Kind switch
    {
        TaskCloseOperationKind.Webhook =>
            $"{operation.WebhookMethod.ToString().ToUpperInvariant()} {operation.WebhookUrl}",
        _ =>
            $"Creates \u201c{operation.FollowUpTitle ?? form.Title}\u201d, {CloseOperationNames.DueDateSummary(operation.DueDateMode, operation.DueDateValue, operation.DueDateOn)}",
    };

    private async Task RemoveOperationAsync(int operationId)
    {
        await CloseOperations.DeleteAsync(operationId);
        operations = await CloseOperations.ListAsync(Id!.Value);
    }

    private async Task DeleteAsync()
    {
        if (Id is not null)
        {
            await Tasks.DeleteAsync(Id.Value);
        }

        Navigation.NavigateTo("tasks");
    }

    /// <summary>What the editor posts back.</summary>
    private class TaskForm
    {
        /// <summary>Short description of the work.</summary>
        public string? Title { get; set; }

        /// <summary>Free-form detail, held as markdown.</summary>
        public string? Notes { get; set; }

        /// <summary>State the task is in.</summary>
        public TaskItemStatus Status { get; set; } = TaskItemStatus.ToDo;

        /// <summary>Id of the chosen category, or empty for none.</summary>
        public string? CategoryId { get; set; }

        /// <summary>Day it is due, or null.</summary>
        public DateTime? DueDate { get; set; }
    }
}
