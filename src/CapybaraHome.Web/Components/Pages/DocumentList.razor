@page "/documents"
@inject TaskCloseOperationService CloseOperations
@inject TimeProvider Clock

<PageTitle>Documents</PageTitle>

<h1>Documents</h1>

<p class="muted">
    Documents a completed task produced. Each one opens on a page laid out to print; printing
    itself is your browser's print dialog, since the server has no printer.
</p>

@if (documents.Count == 0)
{
    <p class="muted">No documents yet. Add a document operation to a task to produce one.</p>
}
else
{
    <div class="card">
        <ul class="task-list">
            @foreach (var document in documents)
            {
                <li>
                    <div class="task-line">
                        <a class="task-link" href="@($"documents/{document.Id}")">@(document.DocumentTitle ?? document.TaskTitle)</a>
                    </div>
                    <div class="task-meta">
                        <span>From @document.TaskTitle</span>
                        <span>@DateNames.LongWithTime(document.CompletedAt, Clock.LocalTimeZone)</span>
                    </div>
                </li>
            }
        </ul>
    </div>
}

<div class="card" style="margin-top:0.75rem">
    <div class="card-head">
        <h2 class="card-title">Recent operations</h2>
    </div>
    @if (runs.Count == 0)
    {
        <p class="muted">No task has run an operation yet.</p>
    }
    else
    {
        <ul class="task-list">
            @foreach (var run in runs)
            {
                <li>
                    <div class="task-line">
                        <span class="task-link">@run.TaskTitle</span>
                        <span class="pill">@CloseOperationNames.Label(run.Kind)</span>
                        <span class="@(run.Status == TaskCloseRunStatus.Failed ? "overdue" : "pill")">@CloseOperationNames.Label(run.Status)</span>
                    </div>
                    <div class="task-meta">
                        <span>@DateNames.LongWithTime(run.CompletedAt, Clock.LocalTimeZone)</span>
                        @if (run.Detail is { Length: > 0 } detail)
                        {
                            <span>@detail</span>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>

@code {
    private IReadOnlyList<TaskCloseRunView> documents = [];
    private IReadOnlyList<TaskCloseRunView> runs = [];

    /// <summary>Loads the produced documents and the most recent runs of every kind.</summary>
    protected override async Task OnParametersSetAsync()
    {
        documents = await CloseOperations.ListDocumentsAsync();
        runs = await CloseOperations.ListRunsAsync();
    }
}
