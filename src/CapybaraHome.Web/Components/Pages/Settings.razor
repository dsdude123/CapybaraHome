@page "/settings"
@inject CategoryService Categories
@inject UserService Users
@inject ApiTokenService Tokens
@inject GroceryService Grocery
@inject BackupWriter Backups
@inject NavigationManager Navigation

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

<section class="card stack" style="margin-bottom:1rem">
    <h2 class="card-title">Categories</h2>

    <table>
        <thead>
            <tr><th>Name</th><th>Tasks</th><th>Done</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var category in categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.TaskCount</td>
                    <td>@category.DoneCount</td>
                    <td>
                        <form method="post" @formname="@($"delete-category-{category.Id}")" @onsubmit="() => DeleteCategoryAsync(category.Id)">
                            <AntiforgeryToken />
                            <button class="btn btn-small btn-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <EditForm Model="categoryForm" FormName="add-category" OnValidSubmit="AddCategoryAsync">
        <div class="row">
            <InputText type="text" placeholder="New category" @bind-Value="categoryForm.Name" style="flex:1 1 12rem" />
            <button class="btn" type="submit">Add</button>
        </div>
    </EditForm>
    @if (categoryError is not null)
    {
        <p class="error">@categoryError</p>
    }
</section>

<section class="card stack" style="margin-bottom:1rem">
    <h2 class="card-title">People</h2>
    <p class="muted">Everyone here shares the same tasks. Only the first account can add or remove accounts.</p>

    <table>
        <thead>
            <tr><th>Name</th><th>Username</th><th>Codes</th><th>Added</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.DisplayName</td>
                    <td>@user.Username</td>
                    <td>@(user.TotpEnabled ? "on" : "off")</td>
                    <td>@user.CreatedAt.ToString("d MMM yyyy")</td>
                    <td>
                        @if (isFirstUser && !user.IsFirstUser)
                        {
                            <form method="post" @formname="@($"remove-user-{user.Id}")" @onsubmit="() => RemoveUserAsync(user.Id)">
                                <AntiforgeryToken />
                                <button class="btn btn-small btn-danger" type="submit">Remove</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (isFirstUser)
    {
        <EditForm Model="userForm" FormName="add-user" OnValidSubmit="AddUserAsync">
            <div class="filters">
                <div>
                    <label for="new-username">Username</label>
                    <InputText id="new-username" type="text" @bind-Value="userForm.Username" autocomplete="off" />
                </div>
                <div>
                    <label for="new-display-name">Name to show</label>
                    <InputText id="new-display-name" type="text" @bind-Value="userForm.DisplayName" autocomplete="off" />
                </div>
                <div>
                    <label for="new-password">Password</label>
                    <InputText id="new-password" type="password" @bind-Value="userForm.Password" autocomplete="new-password" />
                </div>
            </div>
            <p class="muted">At least @PasswordHasher.MinimumLength characters. Tell them the password yourself; they can change it under Your account.</p>
            <button class="btn" type="submit">Add the account</button>
        </EditForm>

        <EditForm Model="resetForm" FormName="reset-password" OnValidSubmit="ResetPasswordAsync" style="margin-top:1rem">
            <div class="filters">
                <div>
                    <label for="reset-user">Reset someone's password</label>
                    <InputSelect id="reset-user" @bind-Value="resetForm.UserId">
                        <option value="">Nobody</option>
                        @foreach (var user in users)
                        {
                            <option value="@user.Id">@user.Username</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label for="reset-password">New password</label>
                    <InputText id="reset-password" type="password" @bind-Value="resetForm.Password" autocomplete="new-password" />
                </div>
            </div>
            <button class="btn" type="submit">Set the password</button>
        </EditForm>
    }

    @if (peopleError is not null)
    {
        <p class="error">@peopleError</p>
    }
    @if (peopleMessage is not null)
    {
        <p class="notice">@peopleMessage</p>
    }
</section>

<section class="card stack" style="margin-bottom:1rem">
    <h2 class="card-title">Frequent grocery items</h2>
    <p class="muted">Every one of these is offered each time a grocery list is generated.</p>

    <table>
        <thead>
            <tr><th>Quantity</th><th>Item</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var item in frequentItems)
            {
                <tr>
                    <td>@item.Quantity</td>
                    <td>@item.Item</td>
                    <td>
                        <form method="post" @formname="@($"delete-frequent-{item.Id}")" @onsubmit="() => DeleteFrequentAsync(item.Id)">
                            <AntiforgeryToken />
                            <button class="btn btn-small btn-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <EditForm Model="frequentForm" FormName="add-frequent" OnValidSubmit="AddFrequentAsync">
        <div class="row">
            <InputText type="text" placeholder="Quantity" @bind-Value="frequentForm.Quantity" style="flex:0 1 8rem" />
            <InputText type="text" placeholder="New frequent item" @bind-Value="frequentForm.Item" style="flex:1 1 12rem" />
            <button class="btn" type="submit">Add</button>
        </div>
    </EditForm>
    @if (frequentError is not null)
    {
        <p class="error">@frequentError</p>
    }
</section>

<section class="card stack" style="margin-bottom:1rem">
    <h2 class="card-title">Connector tokens</h2>
    <p class="muted">
        A token lets the Claude connector reach this installation. Point the connector at
        <code>@McpUrl</code> and send the token as a bearer token.
    </p>

    @if (mintedSecret is not null)
    {
        <div class="notice">
            <p>Copy this now. It is not shown again.</p>
            <code class="secret">@mintedSecret</code>
        </div>
    }

    <table>
        <thead>
            <tr><th>Name</th><th>Starts with</th><th>Last used</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var token in tokens)
            {
                <tr>
                    <td>@token.Name</td>
                    <td><code>@token.Prefix…</code></td>
                    <td>@(token.LastUsedAt?.ToString("d MMM yyyy") ?? "never")</td>
                    <td>
                        @if (token.RevokedAt is null)
                        {
                            <form method="post" @formname="@($"revoke-token-{token.Id}")" @onsubmit="() => RevokeTokenAsync(token.Id)">
                                <AntiforgeryToken />
                                <button class="btn btn-small btn-danger" type="submit">Revoke</button>
                            </form>
                        }
                        else
                        {
                            <span class="muted">revoked</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <EditForm Model="tokenForm" FormName="mint-token" OnValidSubmit="MintTokenAsync">
        <div class="row">
            <InputText type="text" placeholder="Token name" @bind-Value="tokenForm.Name" style="flex:1 1 12rem" />
            <button class="btn" type="submit">Mint a token</button>
        </div>
    </EditForm>
    @if (tokenError is not null)
    {
        <p class="error">@tokenError</p>
    }
</section>

<section class="card stack">
    <h2 class="card-title">Data</h2>

    <div class="row">
        <a class="btn" href="api/export">Download an export</a>
        <form method="post" @formname="backup-now" @onsubmit="BackupNowAsync">
            <AntiforgeryToken />
            <button class="btn" type="submit">Back up now</button>
        </form>
    </div>
    <p class="muted">The export is one JSON file holding every category, task, meal, dashboard card and grocery list.</p>

    <form method="post" action="settings/import" enctype="multipart/form-data" class="stack">
        <AntiforgeryToken />
        <div class="field">
            <label for="import-file">Restore from an export file</label>
            <input id="import-file" type="file" name="file" accept=".json,application/json" required />
        </div>
        <div class="row">
            <select name="mode" style="flex:0 1 12rem">
                <option value="@ImportMode.Merge">Merge into what is here</option>
                <option value="@ImportMode.Replace">Replace everything</option>
            </select>
            <button class="btn" type="submit">Import the file</button>
        </div>
    </form>

    <div class="row" style="margin-top:1rem">
        <a class="btn btn-primary" href="settings/jira">Import from JIRA</a>
    </div>
    <p class="muted">Connects to your JIRA Cloud site and pulls a project's issues in.</p>

    @if (dataMessage is not null)
    {
        <p class="notice">@dataMessage</p>
    }
    @if (dataError is not null)
    {
        <p class="error">@dataError</p>
    }
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [SupplyParameterFromQuery(Name = "imported")]
    private string? ImportedSummary { get; set; }

    [SupplyParameterFromQuery(Name = "importError")]
    private string? ImportError { get; set; }

    private IReadOnlyList<CategoryView> categories = [];
    private IReadOnlyList<UserView> users = [];
    private IReadOnlyList<ApiTokenView> tokens = [];
    private IReadOnlyList<FrequentGroceryItemView> frequentItems = [];
    private bool isFirstUser;

    private string? categoryError;
    private string? peopleError;
    private string? peopleMessage;
    private string? tokenError;
    private string? frequentError;
    private string? mintedSecret;
    private string? dataMessage;
    private string? dataError;

    [SupplyParameterFromForm(Name = "categoryForm")]
    private NameForm? postedCategoryForm { get; set; }

    [SupplyParameterFromForm(Name = "tokenForm")]
    private NameForm? postedTokenForm { get; set; }

    [SupplyParameterFromForm(Name = "userForm")]
    private NewUserForm? postedUserForm { get; set; }

    [SupplyParameterFromForm(Name = "resetForm")]
    private ResetForm? postedResetForm { get; set; }

    [SupplyParameterFromForm(Name = "frequentForm")]
    private FrequentForm? postedFrequentForm { get; set; }

    // A post binds only the form it came from, leaving the others null, so each one falls back
    // to empty values rather than handing EditForm a null model.
    private NameForm categoryForm => postedCategoryForm ??= new();

    private NameForm tokenForm => postedTokenForm ??= new();

    private NewUserForm userForm => postedUserForm ??= new();

    private ResetForm resetForm => postedResetForm ??= new();

    private FrequentForm frequentForm => postedFrequentForm ??= new();

    private static string McpUrl => "/mcp";

    /// <summary>Loads every list the page shows, and the result of a file import if one just ran.</summary>
    protected override async Task OnInitializedAsync()
    {
        dataMessage = ImportedSummary;
        dataError = ImportError;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        categories = await Categories.ListAsync();
        users = await Users.ListAsync();
        tokens = await Tokens.ListAsync();
        frequentItems = await Grocery.ListFrequentAsync();

        var state = AuthenticationState is null ? null : await AuthenticationState;
        isFirstUser = state?.User.IsFirstUser() ?? false;
    }

    private async Task<int?> CurrentUserIdAsync()
    {
        if (AuthenticationState is null)
        {
            return null;
        }

        var state = await AuthenticationState;
        return state.User.GetUserId();
    }

    private async Task AddCategoryAsync()
    {
        categoryError = null;
        try
        {
            await Categories.CreateAsync(new CategoryRequest(categoryForm.Name ?? string.Empty));
        }
        catch (ArgumentException ex)
        {
            categoryError = ex.Message;
            return;
        }

        Reload();
    }

    private async Task DeleteCategoryAsync(int id)
    {
        await Categories.DeleteAsync(id);
        Reload();
    }

    private async Task AddFrequentAsync()
    {
        frequentError = null;
        try
        {
            await Grocery.AddFrequentAsync(new GroceryItemInput(frequentForm.Item ?? string.Empty, frequentForm.Quantity));
        }
        catch (ArgumentException ex)
        {
            frequentError = ex.Message;
            return;
        }

        Reload();
    }

    private async Task DeleteFrequentAsync(int id)
    {
        await Grocery.RemoveFrequentAsync(id);
        Reload();
    }

    private async Task AddUserAsync()
    {
        peopleError = null;
        peopleMessage = null;

        var actingId = await CurrentUserIdAsync();
        if (actingId is null)
        {
            peopleError = "Sign in again before adding an account.";
            return;
        }

        try
        {
            await Users.CreateUserAsync(
                userForm.Username ?? string.Empty,
                userForm.DisplayName ?? string.Empty,
                userForm.Password ?? string.Empty,
                actingId.Value);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            peopleError = ex.Message;
            return;
        }

        Reload();
    }

    private async Task ResetPasswordAsync()
    {
        peopleError = null;
        peopleMessage = null;

        var actingId = await CurrentUserIdAsync();
        if (actingId is null || !int.TryParse(resetForm.UserId, out var userId))
        {
            peopleError = "Choose whose password to reset.";
            return;
        }

        try
        {
            await Users.ResetPasswordAsync(userId, resetForm.Password ?? string.Empty, actingId.Value);
            peopleMessage = "The password is set. Tell them what it is.";
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            peopleError = ex.Message;
        }
    }

    private async Task RemoveUserAsync(int id)
    {
        peopleError = null;
        peopleMessage = null;

        var actingId = await CurrentUserIdAsync();
        if (actingId is null)
        {
            peopleError = "Sign in again before removing an account.";
            return;
        }

        try
        {
            await Users.DeleteUserAsync(id, actingId.Value);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            peopleError = ex.Message;
            return;
        }

        Reload();
    }

    private async Task MintTokenAsync()
    {
        tokenError = null;
        var userId = await CurrentUserIdAsync();
        if (userId is null)
        {
            tokenError = "Sign in again before minting a token.";
            return;
        }

        try
        {
            // The secret is shown in this response and never again, so the page cannot redirect
            // here the way the other actions do.
            var minted = await Tokens.CreateAsync(tokenForm.Name ?? string.Empty, userId.Value);
            mintedSecret = minted.Secret;
            tokenForm.Name = null;
        }
        catch (ArgumentException ex)
        {
            tokenError = ex.Message;
            return;
        }

        await ReloadAsync();
    }

    private async Task RevokeTokenAsync(int id)
    {
        await Tokens.RevokeAsync(id);
        Reload();
    }

    private async Task BackupNowAsync()
    {
        dataError = null;
        try
        {
            var path = await Backups.WriteAsync();
            dataMessage = $"Wrote a backup to {path}.";
        }
        catch (Exception ex)
        {
            dataError = ex.Message;
        }
    }

    /// <summary>Sends the browser back to a freshly rendered page, so a refresh does not post again.</summary>
    private void Reload() => Navigation.NavigateTo("/settings");

    /// <summary>What the add-a-category and mint-a-token forms post back.</summary>
    private class NameForm
    {
        /// <summary>The name that was typed.</summary>
        public string? Name { get; set; }
    }

    /// <summary>What the add-a-frequent-item form posts back.</summary>
    private class FrequentForm
    {
        /// <summary>How much is usually bought, as typed.</summary>
        public string? Quantity { get; set; }

        /// <summary>What the item is, as typed.</summary>
        public string? Item { get; set; }
    }

    /// <summary>What the add-an-account form posts back.</summary>
    private class NewUserForm
    {
        /// <summary>Username to sign in with.</summary>
        public string? Username { get; set; }

        /// <summary>Name to show around the app.</summary>
        public string? DisplayName { get; set; }

        /// <summary>First password for the account.</summary>
        public string? Password { get; set; }
    }

    /// <summary>What the reset-a-password form posts back.</summary>
    private class ResetForm
    {
        /// <summary>Id of the account to reset, as the select posts it.</summary>
        public string? UserId { get; set; }

        /// <summary>The new password.</summary>
        public string? Password { get; set; }
    }
}
