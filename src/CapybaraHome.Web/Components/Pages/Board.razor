@page "/board"
@inject TaskService Tasks
@inject CategoryService Categories
@inject NavigationManager Navigation

<PageTitle>Board</PageTitle>

<div class="page-head">
    <h1>Board</h1>
    <a class="btn btn-primary btn-small" href="tasks/new">Create</a>
</div>

<form method="get" action="board" class="card" style="margin-bottom:1rem">
    <div class="filters">
        <div>
            <label for="board-category">Category</label>
            <select id="board-category" name="category">
                <option value="" selected="@(Category is null or "")">All</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id" selected="@(Category == category.Id.ToString())">@category.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="board-due">Due within (days)</label>
            <input id="board-due" type="number" min="0" name="due" value="@Due" />
        </div>
        <div>
            <label for="board-sort">Sort by</label>
            <select id="board-sort" name="sort">
                @foreach (var value in TaskSortNames.All)
                {
                    <option value="@TaskSortNames.Value(value)" selected="@(sort == value)">@TaskSortNames.Label(value)</option>
                }
            </select>
        </div>
    </div>
    <div class="row" style="margin-top:0.5rem">
        <button class="btn" type="submit">Filter</button>
        <a class="btn" href="board">Clear</a>
    </div>
</form>

<div class="board">
    @foreach (var status in StatusNames.All)
    {
        <section class="board-column">
            <h2>
                <span>@StatusNames.Label(status)</span>
                <span class="muted">@Count(status)</span>
            </h2>

            @foreach (var task in Column(status))
            {
                <article class="board-card">
                    <div class="card-head">
                        <a class="task-link" href="@($"tasks/{task.Id}")">@task.Title</a>
                        <details class="card-menu">
                            <summary class="btn btn-small menu-button" title="Move this task" aria-label="@($"Move {task.Title}")">⋯</summary>
                            <div class="menu-panel">
                                @foreach (var target in StatusNames.All)
                                {
                                    if (target != status)
                                    {
                                        <form method="post" class="menu-item" @formname="@($"move-{task.Id}-{target}")" @onsubmit="() => MoveAsync(task.Id, target)">
                                            <AntiforgeryToken />
                                            <button class="btn btn-small menu-action" type="submit">Move to @StatusNames.Label(target)</button>
                                        </form>
                                    }
                                }
                            </div>
                        </details>
                    </div>
                    <div class="task-meta">
                        <span>@(task.CategoryName ?? "Uncategorized")</span>
                        @if (task.DueDate is { } due)
                        {
                            <span class="@(IsOverdue(task) ? "overdue" : null)">Due @DateNames.Long(due)</span>
                        }
                    </div>
                </article>
            }

            @if (Remaining(status) is > 0)
            {
                <a class="btn btn-small board-more" href="@BoardLink(status)">
                    Load @Math.Min(ColumnPageSize, Remaining(status)) more
                </a>
            }
        </section>
    }
</div>

@code {
    /// <summary>Category id to filter on, or empty for all.</summary>
    [SupplyParameterFromQuery(Name = "category")]
    private string? Category { get; set; }

    /// <summary>Days-away bound to filter on, or null for any.</summary>
    [SupplyParameterFromQuery(Name = "due")]
    private int? Due { get; set; }

    /// <summary>Name of the order to sort each column in, or empty for the default.</summary>
    [SupplyParameterFromQuery(Name = "sort")]
    private string? Sort { get; set; }

    /// <summary>How many cards the To do column shows, or null for one column's worth.</summary>
    [SupplyParameterFromQuery(Name = "todo")]
    private int? ToDoShown { get; set; }

    /// <summary>How many cards the In progress column shows, or null for one column's worth.</summary>
    [SupplyParameterFromQuery(Name = "progress")]
    private int? InProgressShown { get; set; }

    /// <summary>How many cards the On hold column shows, or null for one column's worth.</summary>
    [SupplyParameterFromQuery(Name = "hold")]
    private int? OnHoldShown { get; set; }

    /// <summary>How many cards the Done column shows, or null for one column's worth.</summary>
    [SupplyParameterFromQuery(Name = "done")]
    private int? DoneShown { get; set; }

    /// <summary>How many cards a column shows before Load more is needed.</summary>
    private const int ColumnPageSize = 20;

    private readonly Dictionary<TaskItemStatus, IReadOnlyList<TaskView>> columns = [];
    private readonly Dictionary<TaskItemStatus, int> counts = [];
    private IReadOnlyList<CategoryView> categories = [];
    private TaskSort sort = TaskSort.DueDate;

    /// <summary>Loads the four columns and the category filter.</summary>
    protected override async Task OnParametersSetAsync()
    {
        categories = await Categories.ListAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var category = int.TryParse(Category, out var parsed) ? parsed : (int?)null;
        sort = TaskSortNames.Parse(Sort);

        foreach (var status in StatusNames.All)
        {
            var filter = new TaskFilter(
                Status: status,
                CategoryId: category,
                DueWithinDays: Due);

            counts[status] = await Tasks.CountAsync(filter);
            columns[status] = await Tasks.ListAsync(filter with { Limit = Shown(status) }, sort);
        }
    }

    private IReadOnlyList<TaskView> Column(TaskItemStatus status) =>
        columns.TryGetValue(status, out var tasks) ? tasks : [];

    private int Count(TaskItemStatus status) =>
        counts.TryGetValue(status, out var count) ? count : 0;

    private int Remaining(TaskItemStatus status) => Count(status) - Column(status).Count;

    /// <summary>
    /// Returns how many cards <paramref name="status"/> is asked to show, never fewer than one
    /// column's worth and never more than the column holds, so a hand-written size cannot ask the
    /// database for the whole table.
    /// </summary>
    private int Shown(TaskItemStatus status) => Math.Clamp(
        Asked(status) ?? ColumnPageSize,
        ColumnPageSize,
        Math.Max(ColumnPageSize, Count(status)));

    private int? Asked(TaskItemStatus status) => status switch
    {
        TaskItemStatus.InProgress => InProgressShown,
        TaskItemStatus.OnHold => OnHoldShown,
        TaskItemStatus.Done => DoneShown,
        _ => ToDoShown,
    };

    private static string ShownName(TaskItemStatus status) => status switch
    {
        TaskItemStatus.InProgress => "progress",
        TaskItemStatus.OnHold => "hold",
        TaskItemStatus.Done => "done",
        _ => "todo",
    };

    /// <summary>
    /// Returns a link to the board with the filters, the order and every column's size kept, and with
    /// <paramref name="expand"/>, when given, grown by one page.
    /// </summary>
    private string BoardLink(TaskItemStatus? expand)
    {
        var query = new List<string>();

        if (!string.IsNullOrEmpty(Category))
        {
            query.Add($"category={Uri.EscapeDataString(Category)}");
        }

        if (Due is { } due)
        {
            query.Add($"due={due}");
        }

        if (sort != TaskSort.DueDate)
        {
            query.Add($"sort={TaskSortNames.Value(sort)}");
        }

        foreach (var status in StatusNames.All)
        {
            var shown = Shown(status) + (status == expand ? ColumnPageSize : 0);
            if (shown > ColumnPageSize)
            {
                query.Add($"{ShownName(status)}={shown}");
            }
        }

        return "/board" + (query.Count == 0 ? string.Empty : "?" + string.Join("&", query));
    }

    private async Task MoveAsync(int id, TaskItemStatus status)
    {
        await Tasks.UpdateAsync(id, new UpdateTaskRequest(Status: status));

        // Back to a freshly rendered board, with the filter kept, so a refresh does not post again.
        Navigation.NavigateTo(BoardLink(null));
    }

    private static bool IsOverdue(TaskView task) =>
        task.Status != TaskItemStatus.Done
        && task.DueDate is { } due
        && due < DateOnly.FromDateTime(DateTime.UtcNow);
}
