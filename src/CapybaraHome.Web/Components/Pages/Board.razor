@page "/board"
@inject TaskService Tasks
@inject CategoryService Categories
@inject NavigationManager Navigation

<PageTitle>Board</PageTitle>

<div class="page-head">
    <h1>Board</h1>
    <a class="btn btn-primary btn-small" href="tasks/new">Create</a>
</div>

<form method="get" action="board" class="card" style="margin-bottom:1rem">
    <div class="filters">
        <div>
            <label for="board-category">Category</label>
            <select id="board-category" name="category">
                <option value="" selected="@(Category is null or "")">All</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id" selected="@(Category == category.Id.ToString())">@category.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="board-due">Due within (days)</label>
            <input id="board-due" type="number" min="0" name="due" value="@Due" />
        </div>
    </div>
    <div class="row" style="margin-top:0.5rem">
        <button class="btn" type="submit">Filter</button>
        <a class="btn" href="board">Clear</a>
    </div>
</form>

<div class="board">
    @foreach (var status in StatusNames.All)
    {
        <section class="board-column">
            <h2>
                <span>@StatusNames.Label(status)</span>
                <span class="muted">@Column(status).Count</span>
            </h2>

            @foreach (var task in Column(status))
            {
                <article class="board-card">
                    <a class="task-link" href="@($"tasks/{task.Id}")">@task.Title</a>
                    <div class="task-meta">
                        <span>@(task.CategoryName ?? "Uncategorized")</span>
                        @if (task.DueDate is { } due)
                        {
                            <span class="@(IsOverdue(task) ? "overdue" : null)">@due.ToString("d MMM")</span>
                        }
                    </div>
                    <div class="row" style="margin-top:0.4rem">
                        @if (Previous(status) is { } previous)
                        {
                            <form method="post" @formname="@($"back-{task.Id}")" @onsubmit="() => MoveAsync(task.Id, previous)">
                                <AntiforgeryToken />
                                <button class="btn btn-small" type="submit" title="@($"Move to {StatusNames.Label(previous)}")">←</button>
                            </form>
                        }
                        @if (Next(status) is { } next)
                        {
                            <form method="post" @formname="@($"on-{task.Id}")" @onsubmit="() => MoveAsync(task.Id, next)">
                                <AntiforgeryToken />
                                <button class="btn btn-small" type="submit" title="@($"Move to {StatusNames.Label(next)}")">→</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </section>
    }
</div>

@code {
    /// <summary>Category id to filter on, or empty for all.</summary>
    [SupplyParameterFromQuery(Name = "category")]
    private string? Category { get; set; }

    /// <summary>Days-away bound to filter on, or null for any.</summary>
    [SupplyParameterFromQuery(Name = "due")]
    private int? Due { get; set; }

    private readonly Dictionary<TaskItemStatus, IReadOnlyList<TaskView>> columns = [];
    private IReadOnlyList<CategoryView> categories = [];

    /// <summary>Loads the four columns and the category filter.</summary>
    protected override async Task OnParametersSetAsync()
    {
        categories = await Categories.ListAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var category = int.TryParse(Category, out var parsed) ? parsed : (int?)null;

        foreach (var status in StatusNames.All)
        {
            columns[status] = await Tasks.ListAsync(new TaskFilter(
                Status: status,
                CategoryId: category,
                DueWithinDays: Due));
        }
    }

    private IReadOnlyList<TaskView> Column(TaskItemStatus status) =>
        columns.TryGetValue(status, out var tasks) ? tasks : [];

    private async Task MoveAsync(int id, TaskItemStatus status)
    {
        await Tasks.UpdateAsync(id, new UpdateTaskRequest(Status: status));

        // Back to a freshly rendered board, with the filter kept, so a refresh does not post again.
        var query = new List<string>();
        if (!string.IsNullOrEmpty(Category))
        {
            query.Add($"category={Uri.EscapeDataString(Category)}");
        }

        if (Due is { } due)
        {
            query.Add($"due={due}");
        }

        Navigation.NavigateTo("/board" + (query.Count == 0 ? string.Empty : "?" + string.Join("&", query)));
    }

    private static TaskItemStatus? Previous(TaskItemStatus status)
    {
        var index = Array.IndexOf(StatusNames.All, status);
        return index > 0 ? StatusNames.All[index - 1] : null;
    }

    private static TaskItemStatus? Next(TaskItemStatus status)
    {
        var index = Array.IndexOf(StatusNames.All, status);
        return index >= 0 && index < StatusNames.All.Length - 1 ? StatusNames.All[index + 1] : null;
    }

    private static bool IsOverdue(TaskView task) =>
        task.Status != TaskItemStatus.Done
        && task.DueDate is { } due
        && due < DateOnly.FromDateTime(DateTime.UtcNow);
}
