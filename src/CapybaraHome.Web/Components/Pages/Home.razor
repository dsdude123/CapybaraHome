@page "/"
@inject DashboardService Dashboard
@inject CategoryService Categories
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<div class="page-head">
    <h1>Dashboard</h1>
</div>

<details class="disclosure" open="@(addError is not null)">
    <summary class="btn btn-small">Add a card</summary>
    <EditForm Model="addForm" FormName="add-card" OnValidSubmit="AddCardAsync">
        <div class="card disclosure-body">
            <div class="field">
                <label for="card-title">Title</label>
                <InputText id="card-title" type="text" @bind-Value="addForm.Title" />
            </div>
            <div class="filters">
                <div>
                    <label for="card-kind">Shows</label>
                    <InputSelect id="card-kind" @bind-Value="addForm.Kind">
                        <option value="@DashboardCardKind.TaskCount">A count</option>
                        <option value="@DashboardCardKind.TaskList">A list of tasks</option>
                        <option value="@DashboardCardKind.CategoryProgress">Progress of a project</option>
                    </InputSelect>
                </div>
                <div>
                    <label for="card-category">Category</label>
                    <InputSelect id="card-category" @bind-Value="addForm.CategoryId">
                        <option value="">Any</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label for="card-status">Status</label>
                    <InputSelect id="card-status" @bind-Value="addForm.Status">
                        <option value="">Any</option>
                        @foreach (var status in StatusNames.All)
                        {
                            <option value="@status">@StatusNames.Label(status)</option>
                        }
                    </InputSelect>
                </div>
                <div>
                    <label for="card-due">Due within (days)</label>
                    <InputNumber id="card-due" min="0" @bind-Value="addForm.DueWithinDays" />
                </div>
            </div>
            @if (addError is not null)
            {
                <p class="error">@addError</p>
            }
            <button class="btn btn-primary" type="submit">Add card</button>
        </div>
    </EditForm>
</details>

@if (cards.Count == 0)
{
    <p class="muted">No cards yet. Add one to watch a project or a filter.</p>
}
else
{
    <p class="muted">Each card's ⋯ menu renames it, removes it, or moves it along the dashboard.</p>
}

<div class="card-grid">
    @for (var position = 0; position < cards.Count; position++)
    {
        var card = cards[position];
        var index = position;

        <section class="card">
            <div class="card-head">
                <h2 class="card-title">@card.Title</h2>
                <details class="card-menu">
                    <summary class="btn btn-small menu-button" title="Card actions" aria-label="@($"Actions for {card.Title}")">⋯</summary>
                    <div class="menu-panel">
                        <EditForm Model="renameForm" FormName="@($"rename-{card.Id}")" OnValidSubmit="() => RenameAsync(card.Id)" class="menu-rename">
                            <label for="@($"rename-title-{card.Id}")">Rename</label>
                            <InputText id="@($"rename-title-{card.Id}")" type="text" @bind-Value="renameForm.Title" placeholder="@card.Title" />
                            <button class="btn btn-small" type="submit">Save</button>
                        </EditForm>

                        <form method="post" class="menu-item" @formname="@($"move-up-{card.Id}")" @onsubmit="() => MoveAsync(card.Id, -1)">
                            <AntiforgeryToken />
                            <button class="btn btn-small menu-action" type="submit" disabled="@(index == 0)">Move up</button>
                        </form>

                        <form method="post" class="menu-item" @formname="@($"move-down-{card.Id}")" @onsubmit="() => MoveAsync(card.Id, 1)">
                            <AntiforgeryToken />
                            <button class="btn btn-small menu-action" type="submit" disabled="@(index == cards.Count - 1)">Move down</button>
                        </form>

                        <form method="post" class="menu-item" @formname="@($"remove-{card.Id}")" @onsubmit="() => RemoveAsync(card.Id)">
                            <AntiforgeryToken />
                            <button class="btn btn-small menu-action btn-danger" type="submit">Remove</button>
                        </form>
                    </div>
                </details>
            </div>

            @switch (card.Kind)
            {
                case DashboardCardKind.CategoryProgress:
                    <p class="metric">@((int)Math.Round(card.Progress * 100))%</p>
                    <div class="progress"><span style="width:@((int)Math.Round(card.Progress * 100))%"></span></div>
                    <p class="muted">@card.Done of @card.Total done</p>
                    break;

                case DashboardCardKind.TaskList:
                    <p class="muted">@card.Total matching</p>
                    <TaskLines Tasks="card.Tasks" />
                    break;

                default:
                    <p class="metric">@card.Total</p>
                    <p class="muted">@Describe(card)</p>
                    break;
            }
        </section>
    }
</div>

@code {
    private IReadOnlyList<DashboardCardView> cards = [];
    private IReadOnlyList<CategoryView> categories = [];
    private string? addError;

    [SupplyParameterFromForm(Name = "addForm")]
    private AddCardForm? postedAddForm { get; set; }

    [SupplyParameterFromForm(Name = "renameForm")]
    private RenameForm? postedRenameForm { get; set; }

    // A post binds only the form it came from, leaving the others null, so each one falls back
    // to empty values rather than handing EditForm a null model.
    private AddCardForm addForm => postedAddForm ??= new();

    private RenameForm renameForm => postedRenameForm ??= new();

    /// <summary>Loads the cards and the categories the add form offers.</summary>
    protected override async Task OnInitializedAsync()
    {
        cards = await Dashboard.GetDashboardAsync();
        categories = await Categories.ListAsync();
    }

    private async Task AddCardAsync()
    {
        addError = null;

        var request = new DashboardCardRequest(
            addForm.Title ?? string.Empty,
            addForm.Kind,
            int.TryParse(addForm.CategoryId, out var categoryId) ? categoryId : null,
            Enum.TryParse<TaskItemStatus>(addForm.Status, out var status) ? status : null,
            addForm.DueWithinDays);

        try
        {
            await Dashboard.CreateAsync(request);
        }
        catch (ArgumentException ex)
        {
            addError = ex.Message;
            return;
        }

        Reload();
    }

    private async Task RenameAsync(int id)
    {
        if (!string.IsNullOrWhiteSpace(renameForm.Title))
        {
            await Dashboard.RenameAsync(id, renameForm.Title);
        }

        Reload();
    }

    private async Task MoveAsync(int id, int offset)
    {
        await Dashboard.MoveAsync(id, offset);
        Reload();
    }

    private async Task RemoveAsync(int id)
    {
        await Dashboard.DeleteAsync(id);
        Reload();
    }

    /// <summary>Sends the browser back to a freshly rendered dashboard, so a refresh does not post again.</summary>
    private void Reload() => Navigation.NavigateTo("/");

    private string Describe(DashboardCardView card)
    {
        var parts = new List<string>();

        if (card.Status is { } status)
        {
            parts.Add(StatusNames.Label(status).ToLowerInvariant());
        }

        if (card.CategoryId is { } categoryId)
        {
            var name = categories.FirstOrDefault(c => c.Id == categoryId)?.Name;
            if (name is not null)
            {
                parts.Add($"in {name}");
            }
        }

        if (card.DueWithinDays is { } days)
        {
            parts.Add(days == 0 ? "due today" : $"due within {days} days");
        }

        return parts.Count == 0 ? "tasks" : $"tasks {string.Join(", ", parts)}";
    }

    /// <summary>What the add-a-card form posts back.</summary>
    private class AddCardForm
    {
        /// <summary>Heading for the new card.</summary>
        public string? Title { get; set; }

        /// <summary>What the new card should show.</summary>
        public DashboardCardKind Kind { get; set; } = DashboardCardKind.TaskCount;

        /// <summary>Id of the category to report on, or empty for any.</summary>
        public string? CategoryId { get; set; }

        /// <summary>Name of the status to filter on, or empty for any.</summary>
        public string? Status { get; set; }

        /// <summary>Days-away bound to filter on, or null for any.</summary>
        public int? DueWithinDays { get; set; }
    }

    /// <summary>What a card's rename form posts back.</summary>
    private class RenameForm
    {
        /// <summary>The card's new heading.</summary>
        public string? Title { get; set; }
    }
}
