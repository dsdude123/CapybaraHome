@page "/report"
@using CapybaraHome.Application.Reports
@using CapybaraHome.Web.Reports
@inject DailyReportPrinting Printing

<PageTitle>Morning Report</PageTitle>

<div class="page-head">
    <h1>Morning Report</h1>
    <div class="row">
        <a class="btn btn-small" href="report/pdf">Download PDF</a>
        <form method="post" @formname="print-report" @onsubmit="PrintAsync">
            <AntiforgeryToken />
            <button class="btn btn-primary btn-small" type="submit" disabled="@(!Printing.HasPrinter)">Print now</button>
        </form>
    </div>
</div>

<p class="muted">@DailyReportText.Heading(report.Date)</p>

@if (printed is not null)
{
    <p class="muted">@printed</p>
}
@if (printError is not null)
{
    <p class="error">@printError</p>
}
@if (!Printing.HasPrinter)
{
    <p class="muted">No printer is configured, so the report can only be read here or downloaded.</p>
}

<section class="card stack" style="margin-bottom:1rem">
    <h2 class="card-title">Weather Forecast</h2>
    @if (report.Weather.Count == 0)
    {
        <p class="muted">Weather data unavailable.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Period</th><th>Condition</th><th>Temp</th><th>Wind</th></tr>
            </thead>
            <tbody>
                @foreach (var period in report.Weather)
                {
                    <tr>
                        <td>@period.Name</td>
                        <td>@period.Condition</td>
                        <td>@DailyReportText.Temperature(period.Temperature)</td>
                        <td>@period.Wind</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="card stack" style="margin-bottom:1rem">
    <h2 class="card-title">Tasks (due within 7 days)</h2>
    @if (report.Tasks.Count == 0)
    {
        <p class="muted">No tasks due within 7 days.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>ID</th><th>Title</th><th>Due Date</th></tr>
            </thead>
            <tbody>
                @foreach (var task in report.Tasks)
                {
                    <tr class="@RowClass(task)">
                        <td>#@task.Id</td>
                        <td><a class="task-link" href="@($"tasks/{task.Id}")">@task.Title</a></td>
                        <td>@DailyReportText.DueDate(task.DueDate)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="card stack" style="margin-bottom:1rem">
    <h2 class="card-title">Meal Plan</h2>
    @if (report.Meals.Count == 0)
    {
        <p class="muted">No meals planned.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>ID</th><th>Title</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var meal in report.Meals)
                {
                    <tr>
                        <td>#@meal.Id</td>
                        <td><a class="task-link" href="@($"meals/{meal.Id}")">@meal.Title</a></td>
                        <td>@MealStatusNames.Label(meal.Status)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="card stack" style="margin-bottom:1rem">
    <h2 class="card-title">Upcoming Events (30 days)</h2>
    @if (report.Events.Count == 0)
    {
        <p class="muted">No upcoming events.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Date</th><th>Event</th><th>Location</th></tr>
            </thead>
            <tbody>
                @foreach (var entry in report.Events)
                {
                    <tr>
                        <td>@DailyReportText.When(entry)</td>
                        <td>@entry.Summary</td>
                        <td>@entry.Location</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="card stack" style="margin-bottom:1rem">
    <h2 class="card-title">Upcoming Holidays (Next 30 Days)</h2>
    @if (report.Holidays.Count == 0)
    {
        <p class="muted">No holidays in the next 30 days.</p>
    }
    else
    {
        <ul>
            @foreach (var holiday in report.Holidays)
            {
                <li>@DailyReportText.Holiday(holiday)</li>
            }
        </ul>
    }
</section>

@if (report.Games.Count > 0)
{
    <section class="card stack" style="margin-bottom:1rem">
        <h2 class="card-title">Mariners Game Today</h2>
        @foreach (var game in report.Games)
        {
            <p>@DailyReportText.Game(game)</p>
        }
    </section>
}

<section class="card stack" style="margin-bottom:1rem">
    <h2 class="card-title">Local News (KING 5)</h2>
    @if (report.LocalNews.Count == 0)
    {
        <p class="muted">No headlines available.</p>
    }
    else
    {
        <ol>
            @foreach (var headline in report.LocalNews)
            {
                <li>@headline.Title</li>
            }
        </ol>
    }
</section>

<section class="card stack">
    <h2 class="card-title">National News (AP)</h2>
    @if (report.NationalNews.Count == 0)
    {
        <p class="muted">No headlines available.</p>
    }
    else
    {
        <ol>
            @foreach (var headline in report.NationalNews)
            {
                <li>@headline.Title</li>
            }
        </ol>
    }
</section>

@code {
    private DailyReport report = Empty();
    private string? printed;
    private string? printError;

    /// <summary>Gathers today's report.</summary>
    protected override async Task OnParametersSetAsync()
    {
        report = await Printing.BuildAsync();
    }

    /// <summary>Sends the report that is on screen to the printer.</summary>
    private async Task PrintAsync()
    {
        printed = null;
        printError = null;

        try
        {
            await Printing.PrintAsync(report);
            printed = $"Sent to {Printing.PrinterHost}.";
        }
        catch (Exception ex)
        {
            printError = ex.Message;
        }
    }

    /// <summary>Returns what marks a task's row: overdue, due today, or nothing.</summary>
    private static string? RowClass(ReportTask task) => task switch
    {
        { IsOverdue: true } => "overdue",
        { IsDueToday: true } => "due-today",
        _ => null,
    };

    /// <summary>A report with nothing in it, held until the real one has been gathered.</summary>
    private static DailyReport Empty() =>
        new(DateOnly.MinValue, [], [], [], [], [], [], [], []);
}
