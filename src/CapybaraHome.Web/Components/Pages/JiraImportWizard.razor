@page "/settings/jira"
@using CapybaraHome.Web.Jira
@inject JiraCloudClient Jira
@inject JiraImportService Import
@inject JiraMealImportService MealImport
@inject MealTagService MealTags
@inject JiraWizardStore Wizard

<PageTitle>Import from JIRA</PageTitle>

<h1>Import from JIRA</h1>

<p class="muted">
    Four steps: sign in to your JIRA Cloud site, pick a project, confirm, and CapybaraHome pulls
    the issues itself. Your API token is used for this import only and is never saved.
</p>

<section class="card stack">
    @if (step == Step.Connect)
    {
        <h2 class="card-title">1. Connect</h2>

        <EditForm Model="connectForm" FormName="jira-connect" OnValidSubmit="ConnectAsync">
            <div class="field">
                <label for="site-url">Site address</label>
                <InputText id="site-url" type="text" @bind-Value="connectForm.SiteUrl"
                           placeholder="your-site.atlassian.net" autocomplete="off" />
            </div>
            <div class="field">
                <label for="account-email">Atlassian account email</label>
                <InputText id="account-email" type="email" @bind-Value="connectForm.Email" autocomplete="off" />
            </div>
            <div class="field">
                <label for="api-token">API token</label>
                <InputText id="api-token" type="password" @bind-Value="connectForm.ApiToken" autocomplete="off" />
                <p class="muted">
                    Make one at
                    <a href="https://id.atlassian.com/manage-profile/security/api-tokens" target="_blank" rel="noreferrer">
                        id.atlassian.com
                    </a>
                    under Security, then paste it here. It is held in memory for this import and nowhere else.
                </p>
            </div>

            <button class="btn btn-primary" type="submit">Connect</button>
        </EditForm>
    }
    else if (step == Step.ChooseProject)
    {
        <h2 class="card-title">2. Pick a project</h2>
        @if (account is not null)
        {
            <p class="muted">Signed in as @account.DisplayName. @projects.Count project(s) visible to this account.</p>
        }

        @if (projects.Count == 0 && error is null)
        {
            <p class="error">This account cannot see any projects.</p>
        }

        <EditForm Model="projectForm" FormName="jira-project" OnValidSubmit="ChooseProjectAsync">
            <InputText type="hidden" @bind-Value="projectForm.Ticket" />

            <InputRadioGroup @bind-Value="projectForm.ProjectKey">
                <div class="stack">
                    @foreach (var project in projects)
                    {
                        <label class="row" style="align-items:center;gap:0.5rem">
                            <InputRadio Value="project.Key" style="width:auto;min-height:0" />
                            <span><code>@project.Key</code> — @project.Name</span>
                        </label>
                    }
                </div>
            </InputRadioGroup>

            <button class="btn btn-primary" type="submit" style="margin-top:0.75rem">Continue</button>
        </EditForm>
    }
    else if (step == Step.Confirm)
    {
        <h2 class="card-title">3. Confirm</h2>
        <p>
            About to copy
            @(approximateCount is { } count ? $"roughly {count} issue(s)" : "every issue")
            from <code>@projectKey</code>.
        </p>
        <p class="muted">
            A copy, either way: nothing is deduplicated, nothing in JIRA is changed, and a row already
            carrying one of these JIRA keys is overwritten. A large project takes a minute, so the page
            waits while it runs.
        </p>

        <div class="row">
            <EditForm Model="importForm" FormName="jira-import" OnValidSubmit="RunAsync">
                <InputText type="hidden" @bind-Value="importForm.Ticket" />

                <fieldset class="check-list">
                    <legend>Import these issues as</legend>
                    <InputRadioGroup @bind-Value="importForm.Kind">
                        <label class="row" style="align-items:center;gap:0.5rem">
                            <InputRadio Value="@("tasks")" style="width:auto;min-height:0" />
                            <span>Tasks — epics become categories, every other issue becomes a task</span>
                        </label>
                        <label class="row" style="align-items:center;gap:0.5rem">
                            <InputRadio Value="@("meals")" style="width:auto;min-height:0" />
                            <span>Meals — each issue becomes a meal, labels become tags, descriptions are carried across whole</span>
                        </label>
                    </InputRadioGroup>
                </fieldset>

                <button class="btn btn-primary" type="submit" style="margin-top:0.5rem">Import</button>
            </EditForm>

            <EditForm Model="backForm" FormName="jira-back" OnValidSubmit="GoBack">
                <InputText type="hidden" @bind-Value="backForm.Ticket" />
                <button class="btn" type="submit">Back</button>
            </EditForm>
        </div>
    }
    else if (step == Step.Facets)
    {
        <h2 class="card-title">4. Sort the labels</h2>
        <p class="muted">
            @labels.Count label(s) on these issues. Say what each one describes and the meal filters get a
            picker per kind instead of one long list. A label already in use keeps the kind it has, and any
            of this can be changed later.
        </p>

        <form method="post" @formname="jira-facets" @onsubmit="ImportMealsAsync">
            <AntiforgeryToken />
            <input type="hidden" name="ticket" value="@facetTicket" />

            <div class="filters">
                @for (var index = 0; index < labels.Count; index++)
                {
                    var label = labels[index];
                    <div>
                        <label for="facet-@index">@label</label>
                        <input type="hidden" name="label" value="@label" />
                        <select id="facet-@index" name="facet">
                            @foreach (var facet in MealTagFacetNames.All)
                            {
                                <option value="@facet" selected="@(Chosen(label) == facet)">@MealTagFacetNames.Label(facet)</option>
                            }
                        </select>
                    </div>
                }
            </div>

            <button class="btn btn-primary" type="submit" style="margin-top:0.75rem">Import the meals</button>
        </form>
    }
    else
    {
        <h2 class="card-title">@(mealReport is null ? "4." : "5.") Done</h2>
        @if (mealReport is { } meals)
        {
            <p class="notice">
                Added @meals.MealsAdded meal(s) and @meals.TagsAdded tag(s), updated @meals.MealsUpdated.
            </p>
            @foreach (var warning in meals.Warnings)
            {
                <p class="muted">@warning</p>
            }

            <div class="row">
                <a class="btn btn-primary" href="meals">See the meals</a>
                <a class="btn" href="settings/jira">Import another project</a>
                <a class="btn" href="settings">Back to settings</a>
            </div>
        }
        else
        {
            <p class="notice">
                Added @report!.CategoriesAdded category(ies) and @report.TasksAdded task(s),
                updated @report.TasksUpdated.
            </p>
            @foreach (var warning in report.Warnings)
            {
                <p class="muted">@warning</p>
            }

            <div class="row">
                <a class="btn btn-primary" href="tasks">See the tasks</a>
                <a class="btn" href="settings/jira">Import another project</a>
                <a class="btn" href="settings">Back to settings</a>
            </div>
        }
    }

    @if (error is not null)
    {
        <p class="error">@error</p>
    }
</section>

@code {
    private enum Step
    {
        Connect,
        ChooseProject,
        Confirm,
        Facets,
        Done,
    }

    private Step step = Step.Connect;
    private JiraAccount? account;
    private IReadOnlyList<JiraProjectSummary> projects = [];
    private string? projectKey;
    private int? approximateCount;
    private JiraImportReport? report;
    private JiraMealImportReport? mealReport;
    private IReadOnlyList<string> labels = [];
    private IReadOnlyList<MealTagView> knownTags = [];
    private string? facetTicket;
    private string? error;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(Name = "connectForm")]
    private ConnectForm? postedConnectForm { get; set; }

    [SupplyParameterFromForm(Name = "projectForm")]
    private TicketForm? postedProjectForm { get; set; }

    [SupplyParameterFromForm(Name = "importForm")]
    private TicketForm? postedImportForm { get; set; }

    [SupplyParameterFromForm(Name = "backForm")]
    private TicketForm? postedBackForm { get; set; }

    // A post binds only the form it came from, leaving the others null, so each one falls back
    // to empty values rather than handing EditForm a null model.
    private ConnectForm connectForm => postedConnectForm ??= new();

    private TicketForm projectForm => postedProjectForm ??= new();

    private TicketForm importForm => postedImportForm ??= new();

    private TicketForm backForm => postedBackForm ??= new();

    /// <summary>
    /// Picks the step to render from the form that was posted, before any handler runs. A static
    /// render only dispatches a form it actually rendered, so the step has to be settled first;
    /// the handlers then move it on.
    /// </summary>
    protected override void OnInitialized()
    {
        // The labels step posts a plain form, since it carries a row per label rather than a model.
        if (HttpContext?.Request.HasFormContentType == true
            && HttpContext.Request.Form["_handler"].ToString() == "jira-facets")
        {
            facetTicket = HttpContext.Request.Form["ticket"];
            step = Step.Facets;
            Describe(facetTicket);
            labels = Wizard.Find(facetTicket)?.Labels ?? [];
            return;
        }

        if (postedImportForm is not null)
        {
            step = Step.Confirm;
            Describe(postedImportForm.Ticket);
        }
        else if (postedProjectForm is not null || postedBackForm is not null)
        {
            step = Step.ChooseProject;
            Describe(postedProjectForm?.Ticket ?? postedBackForm?.Ticket);
        }
    }

    /// <summary>Fills in what the page shows about a ticket's connection, quietly if it has expired.</summary>
    private void Describe(string? ticket)
    {
        if (Wizard.Find(ticket) is { } entry)
        {
            account = entry.Account;
            projects = entry.Projects;
            projectKey = entry.ProjectKey;
        }
    }

    private async Task ConnectAsync()
    {
        error = null;

        try
        {
            var connection = JiraConnection.Create(connectForm.SiteUrl, connectForm.Email, connectForm.ApiToken);
            account = await Jira.VerifyAsync(connection);
            projects = await Jira.ListProjectsAsync(connection);

            var ticket = Wizard.Add(connection, account, projects);
            projectForm.Ticket = ticket;
            projectForm.ProjectKey = projects.Count == 1 ? projects[0].Key : null;
            step = Step.ChooseProject;
        }
        catch (Exception ex) when (ex is ArgumentException or JiraRequestException)
        {
            error = ex.Message;
        }
        finally
        {
            // The form re-renders with what was posted, so the token is dropped rather than
            // written back into the page as the value of the password field.
            connectForm.ApiToken = null;
        }
    }

    private async Task ChooseProjectAsync()
    {
        error = null;

        var entry = Resume(projectForm.Ticket);
        if (entry is null)
        {
            return;
        }

        try
        {
            entry.ProjectKey = projectForm.ProjectKey;
            projectKey = projectForm.ProjectKey;
            approximateCount = await Jira.CountIssuesAsync(entry.Connection, JiraCloudClient.ProjectQuery(projectKey));
            importForm.Ticket = projectForm.Ticket;
            backForm.Ticket = projectForm.Ticket;
            step = Step.Confirm;
        }
        catch (Exception ex) when (ex is ArgumentException or JiraRequestException)
        {
            error = ex.Message;
            step = Step.ChooseProject;
        }
    }

    private async Task RunAsync()
    {
        error = null;

        var entry = Resume(importForm.Ticket);
        if (entry is null)
        {
            return;
        }

        projectKey = entry.ProjectKey;

        JiraIssueSnapshot? snapshot = null;

        try
        {
            snapshot = await Jira.FetchIssuesAsync(entry.Connection, JiraCloudClient.ProjectQuery(projectKey));

            // Meals take one more step, where the labels are sorted into the kinds the filters use,
            // so the credentials are kept until that step has run the import.
            if (importForm.Kind == "meals")
            {
                entry.Labels = JiraMealImportService.Labels(snapshot.Issues);
                labels = entry.Labels;
                knownTags = await MealTags.ListAsync();
                facetTicket = importForm.Ticket;
                step = labels.Count > 0 ? Step.Facets : Step.Done;

                if (step == Step.Done)
                {
                    mealReport = await MealImport.ImportAsync(snapshot.Issues);
                    Wizard.Remove(importForm.Ticket);
                    return;
                }

                // The board the labels were read from is the board that gets imported, so it is
                // held for the next step rather than fetched again. The store disposes it.
                entry.Snapshot = snapshot;
                snapshot = null;
                return;
            }

            report = await Import.ImportAsync(snapshot.Issues);

            // The credentials are of no further use, so they go now rather than at expiry.
            Wizard.Remove(importForm.Ticket);
            step = Step.Done;
        }
        catch (Exception ex) when (ex is ArgumentException or JiraRequestException or InvalidOperationException)
        {
            error = ex.Message;
            step = Step.Confirm;
        }
        finally
        {
            snapshot?.Dispose();
        }
    }

    /// <summary>Runs the meal import once the labels have been sorted.</summary>
    private async Task ImportMealsAsync()
    {
        error = null;

        if (HttpContext is null)
        {
            return;
        }

        var entry = Resume(facetTicket);
        if (entry is null)
        {
            return;
        }

        projectKey = entry.ProjectKey;

        var postedLabels = HttpContext.Request.Form["label"];
        var postedFacets = HttpContext.Request.Form["facet"];
        var facets = new Dictionary<string, MealTagFacet>(StringComparer.OrdinalIgnoreCase);

        for (var index = 0; index < postedLabels.Count; index++)
        {
            if (postedLabels[index] is { Length: > 0 } label
                && index < postedFacets.Count
                && Enum.TryParse<MealTagFacet>(postedFacets[index], out var facet))
            {
                facets[label] = facet;
            }
        }

        try
        {
            var snapshot = entry.Snapshot
                ?? await Jira.FetchIssuesAsync(entry.Connection, JiraCloudClient.ProjectQuery(projectKey));
            entry.Snapshot = snapshot;

            mealReport = await MealImport.ImportAsync(snapshot.Issues, facets);

            Wizard.Remove(facetTicket);
            step = Step.Done;
        }
        catch (Exception ex) when (ex is ArgumentException or JiraRequestException or InvalidOperationException)
        {
            error = ex.Message;
            step = Step.Facets;
        }
    }

    /// <summary>Returns the kind a label is already filed under, or a trait when it is new.</summary>
    private MealTagFacet Chosen(string label) =>
        knownTags.FirstOrDefault(tag => string.Equals(tag.Name, label, StringComparison.OrdinalIgnoreCase))?.Facet
            ?? MealTagFacet.Trait;

    private void GoBack()
    {
        error = null;

        if (Resume(backForm.Ticket) is not null)
        {
            step = Step.ChooseProject;
            projectForm.Ticket = backForm.Ticket;
        }
    }

    /// <summary>
    /// Picks the wizard back up where a ticket left it. A ticket the store no longer holds sends
    /// the browser back to step one, since the credentials were never written down anywhere else.
    /// </summary>
    private JiraWizardStore.Entry? Resume(string? ticket)
    {
        var entry = Wizard.Find(ticket);
        if (entry is null)
        {
            error = $"This import sat unfinished for more than {JiraWizardStore.Lifetime.TotalMinutes:0} minutes, so the connection was dropped. Connect again.";
            step = Step.Connect;
            return null;
        }

        account = entry.Account;
        projects = entry.Projects;
        projectKey = entry.ProjectKey;
        return entry;
    }

    /// <summary>What step one posts back.</summary>
    private class ConnectForm
    {
        /// <summary>Address of the JIRA Cloud site.</summary>
        public string? SiteUrl { get; set; }

        /// <summary>Email address of the Atlassian account.</summary>
        public string? Email { get; set; }

        /// <summary>API token for that account.</summary>
        public string? ApiToken { get; set; }
    }

    /// <summary>What the later steps post back: the ticket, and the project where one is being chosen.</summary>
    private class TicketForm
    {
        /// <summary>Ticket that finds the connection again.</summary>
        public string? Ticket { get; set; }

        /// <summary>Key of the chosen project.</summary>
        public string? ProjectKey { get; set; }

        /// <summary>What the issues are imported as: <c>tasks</c> or <c>meals</c>.</summary>
        public string Kind { get; set; } = "tasks";
    }
}
