@page "/homes"
@inject HomeSearchBoardService Board
@inject HomeSearchService Search

<PageTitle>Homes</PageTitle>

<div class="page-head">
    <h1>Homes</h1>
    <div class="row">
        <a class="btn btn-small" href="homes/settings">Search settings</a>
        <a class="btn btn-primary btn-small" href="homes/new">Add a property</a>
    </div>
</div>

@if (board is null)
{
    <p class="muted">Loading.</p>
}
else
{
    @if (board.Profiles.Count > 1)
    {
        <form method="post" @formname="board-profile" @onsubmit="SwitchAsync" class="card row" style="align-items:flex-end">
            <AntiforgeryToken />
            <div class="field">
                <label for="board-profile">Scenario</label>
                <select id="board-profile" name="profile">
                    @foreach (var profile in board.Profiles)
                    {
                        <option value="@profile.Id" selected="@profile.IsActive">@profile.Name</option>
                    }
                </select>
            </div>
            <button class="btn btn-small btn-primary" type="submit">Switch to it</button>
            <a class="btn btn-small" href="homes/settings">Scenarios</a>
        </form>
    }
    else if (board.Profile is { } only)
    {
        <p class="muted">
            Scored under @only.Name. <a href="homes/settings">Add a scenario</a> to keep more than
            one set of weights, destinations and cars.
        </p>
    }

    @if (!board.Settings.AnyWeightSet && board.Priorities.All(p => p.Points == 0m))
    {
        <p class="notice">
            No scoring weights are set yet, so every property scores zero.
            <a href="homes/settings">Set the weights</a> for fees, size, drive times, amenities
            and pros and cons.
        </p>
    }

    <section class="card stack">
        <h2 class="card-title">Where I live now</h2>
        @if (board.Current is null)
        {
            <p class="muted">
                Nothing is marked as your current home, so the fees and the drive times have
                nothing to be compared against. Add it and tick the box on the editor.
            </p>
        }
        else
        {
            <div class="task-line">
                <a class="task-link" href="homes/@board.Current.Id">@board.Current.Name</a>
                <span class="muted">@Money(board.Current.MonthlyTotal) a month</span>
            </div>
            <p class="task-meta">@Baseline(board.Current)</p>
            @if (board.CurrentDriving is { } driving && driving.AnyDriving)
            {
                <p class="task-meta">@Money(driving.MonthlyCost) a month driving, over @MilesAWeek(driving.MilesPerWeek)</p>
            }
        }
    </section>

    <h2>Candidates</h2>

    @if (board.Candidates.Count == 0)
    {
        <p class="muted">No candidates yet.</p>
    }
    else
    {
        <ul class="task-list card">
            @foreach (var scored in board.Candidates)
            {
                <li>
                    <div class="task-line">
                        <a class="task-link" href="homes/@scored.Property.Id">@scored.Property.Name</a>
                        <strong>@Points(scored.Score.Total)</strong>
                    </div>
                    <div class="facts">
                        <span><span class="muted">A month</span> @Money(scored.Property.MonthlyTotal)</span>
                        <span><span class="muted">Deposit</span> @Money(scored.Property.Deposit)</span>
                        <span><span class="muted">Size</span> @SquareFeet(scored.Property.SquareFeet)</span>
                        <span><span class="muted">Rent a sq ft</span> @Cents(scored.Property.RentPerSquareFoot)</span>
                        @foreach (var destination in board.Destinations)
                        {
                            var line = scored.Score.DriveTimeLines.FirstOrDefault(d => d.DestinationId == destination.Id);
                            <span><span class="muted">@destination.Name</span> @Minutes(line?.Minutes)</span>
                        }
                        @if (scored.Driving.AnyDriving)
                        {
                            <span><span class="muted">Driving a month</span> @Money(scored.Driving.MonthlyCost)</span>
                        }
                        <span>
                            <span class="muted">Priorities</span>
                            @scored.Property.Priorities.Count(p => p.Meets == true) of @board.Priorities.Count
                        </span>
                    </div>
                </li>
            }
        </ul>

        <p class="muted">
            A candidate's score is the difference from your current home in fees, size and drive times,
            plus what its amenities, pros, cons and priorities are worth.
        </p>
    }
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private HomeSearchBoard? board;

    /// <summary>Loads the properties, the setup and the scores.</summary>
    protected override async Task OnParametersSetAsync()
    {
        board = await Board.GetAsync();
    }

    private async Task SwitchAsync()
    {
        if (HttpContext is null)
        {
            return;
        }

        if (int.TryParse(
            HttpContext.Request.Form["profile"],
            System.Globalization.CultureInfo.InvariantCulture,
            out var id))
        {
            await Search.ActivateProfileAsync(id);
        }

        board = await Board.GetAsync();
    }

    private static string Baseline(PropertyView current) =>
        $"{Money(current.Rent)} rent, {Money(current.UtilitiesTotal)} utilities, {Money(current.Deposit)} deposit"
        + (current.SquareFeet is null ? string.Empty : $", {SquareFeet(current.SquareFeet)}")
        + (current.RentPerSquareFoot is null ? string.Empty : $", {Cents(current.RentPerSquareFoot)} rent a sq ft");

    // The container has no locale, so a currency format renders the generic sign rather than a
    // dollar one; the weights are labelled per dollar, so the sign is written out here.
    private static string Money(decimal? value) =>
        value is null
            ? "\u2014"
            : (value < 0 ? "\u2212$" : "$") + Math.Abs(value.Value).ToString("N0", System.Globalization.CultureInfo.InvariantCulture);

    private static string Cents(decimal? value) =>
        value is null
            ? "\u2014"
            : "$" + value.Value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

    private static string SquareFeet(int? size) =>
        size is { } known
            ? known.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) + " sq ft"
            : "\u2014";

    private static string Points(decimal value) =>
        (value > 0 ? "+" : string.Empty) + value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string MilesAWeek(double miles) =>
        miles.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + " miles a week";

    private static string Minutes(double? minutes) =>
        minutes is { } value
            ? value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + " min"
            : "—";
}
