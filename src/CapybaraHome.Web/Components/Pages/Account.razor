@page "/account"
@inject UserService Users

<PageTitle>Your account</PageTitle>

<h1>Your account</h1>

@if (user is null)
{
    <p class="muted">Sign in again.</p>
}
else
{
    <p class="muted">Signed in as @user.DisplayName (@user.Username).</p>

    <section class="card stack" style="margin-bottom:1rem">
        <h2 class="card-title">Password</h2>

        <EditForm Model="passwordForm" FormName="change-password" OnValidSubmit="ChangePasswordAsync">
            <div class="field">
                <label for="current">Current password</label>
                <InputText id="current" type="password" @bind-Value="passwordForm.Current" autocomplete="current-password" />
            </div>
            <div class="field">
                <label for="new">New password</label>
                <InputText id="new" type="password" @bind-Value="passwordForm.New" autocomplete="new-password" />
                <p class="muted">At least @PasswordHasher.MinimumLength characters.</p>
            </div>
            <div class="field">
                <label for="again">New password again</label>
                <InputText id="again" type="password" @bind-Value="passwordForm.Confirm" autocomplete="new-password" />
            </div>

            @if (passwordError is not null)
            {
                <p class="error">@passwordError</p>
            }
            @if (passwordMessage is not null)
            {
                <p class="notice">@passwordMessage</p>
            }

            <button class="btn" type="submit">Change the password</button>
        </EditForm>
    </section>

    <section class="card stack">
        <h2 class="card-title">Authenticator</h2>

        @if (user.TotpEnabled && enrolment is null)
        {
            <p>Sign-in asks for a code from your authenticator app.</p>
            <EditForm Model="disableForm" FormName="disable-totp" OnValidSubmit="DisableTotpAsync">
                <div class="field">
                    <label for="disable-password">Your password, to turn it off</label>
                    <InputText id="disable-password" type="password" @bind-Value="disableForm.Password" autocomplete="current-password" />
                </div>
                <button class="btn btn-danger" type="submit">Turn codes off</button>
            </EditForm>
        }
        else if (enrolment is null)
        {
            <p>Codes are off. Turning them on adds a second step to sign-in.</p>
            <form method="post" @formname="begin-totp" @onsubmit="BeginTotpAsync">
                <AntiforgeryToken />
                <button class="btn" type="submit">Set up an authenticator</button>
            </form>
        }
        else
        {
            <p>Add this secret to your authenticator app, then type the code it shows to confirm.</p>
            <code class="secret">@enrolment.Secret</code>
            <p class="muted">Or open this link on the device with the app: <a href="@enrolment.Uri">@enrolment.Uri</a></p>

            <EditForm Model="codeForm" FormName="confirm-totp" OnValidSubmit="ConfirmTotpAsync">
                <div class="field">
                    <label for="confirm-code">Code from the app</label>
                    <InputText id="confirm-code" @bind-Value="codeForm.Code" inputmode="numeric" autocomplete="one-time-code" />
                </div>
                <button class="btn btn-primary" type="submit">Confirm</button>
            </EditForm>

            <form method="post" @formname="cancel-totp" @onsubmit="CancelTotpAsync">
                <AntiforgeryToken />
                <button class="btn" type="submit">Cancel</button>
            </form>
        }

        @if (totpError is not null)
        {
            <p class="error">@totpError</p>
        }
        @if (totpMessage is not null)
        {
            <p class="notice">@totpMessage</p>
        }
    </section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [SupplyParameterFromForm(Name = "passwordForm")]
    private PasswordForm? postedPasswordForm { get; set; }

    [SupplyParameterFromForm(Name = "disableForm")]
    private PasswordOnlyForm? postedDisableForm { get; set; }

    [SupplyParameterFromForm(Name = "codeForm")]
    private CodeForm? postedCodeForm { get; set; }

    // A post binds only the form it came from, leaving the others null, so each one falls back
    // to empty values rather than handing EditForm a null model.
    private PasswordForm passwordForm => postedPasswordForm ??= new();

    private PasswordOnlyForm disableForm => postedDisableForm ??= new();

    private CodeForm codeForm => postedCodeForm ??= new();

    private UserView? user;
    private TotpEnrolment? enrolment;
    private string? passwordError;
    private string? passwordMessage;
    private string? totpError;
    private string? totpMessage;

    /// <summary>Loads the signed-in account and any enrolment it has started.</summary>
    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        var id = await CurrentUserIdAsync();
        user = id is null ? null : await Users.GetAsync(id.Value);

        // The unconfirmed secret is on the account, so the panel comes back after a post
        // without the page having to hold anything between requests.
        enrolment = id is null ? null : await Users.GetPendingTotpEnrolmentAsync(id.Value);
    }

    private async Task<int?> CurrentUserIdAsync()
    {
        if (AuthenticationState is null)
        {
            return null;
        }

        var state = await AuthenticationState;
        return state.User.GetUserId();
    }

    private async Task ChangePasswordAsync()
    {
        passwordError = null;
        passwordMessage = null;

        if (passwordForm.New != passwordForm.Confirm)
        {
            passwordError = "The two new passwords are not the same.";
            return;
        }

        var id = await CurrentUserIdAsync();
        if (id is null)
        {
            passwordError = "Sign in again.";
            return;
        }

        try
        {
            await Users.ChangePasswordAsync(id.Value, passwordForm.Current ?? string.Empty, passwordForm.New ?? string.Empty);
            passwordMessage = "The password is changed.";
        }
        catch (ArgumentException ex)
        {
            passwordError = ex.Message;
        }
        finally
        {
            // What was posted would otherwise be written back into the page as the fields' values.
            passwordForm.Current = passwordForm.New = passwordForm.Confirm = null;
        }
    }

    private async Task BeginTotpAsync()
    {
        totpError = null;
        totpMessage = null;

        var id = await CurrentUserIdAsync();
        if (id is not null)
        {
            enrolment = await Users.BeginTotpEnrolmentAsync(id.Value);
        }
    }

    private async Task ConfirmTotpAsync()
    {
        totpError = null;
        var id = await CurrentUserIdAsync();
        if (id is null)
        {
            return;
        }

        if (await Users.ConfirmTotpAsync(id.Value, codeForm.Code ?? string.Empty))
        {
            totpMessage = "Codes are on. Sign-in will ask for one from now on.";
        }
        else
        {
            totpError = "That code is not right. Try the current one.";
        }

        codeForm.Code = null;
        await ReloadAsync();
    }

    private async Task CancelTotpAsync()
    {
        totpError = null;
        totpMessage = null;

        var id = await CurrentUserIdAsync();
        if (id is not null)
        {
            await Users.CancelTotpEnrolmentAsync(id.Value);
            await ReloadAsync();
        }
    }

    private async Task DisableTotpAsync()
    {
        totpError = null;
        totpMessage = null;

        var id = await CurrentUserIdAsync();
        if (id is null)
        {
            return;
        }

        try
        {
            await Users.DisableTotpAsync(id.Value, disableForm.Password ?? string.Empty);
            totpMessage = "Codes are off.";
            await ReloadAsync();
        }
        catch (ArgumentException ex)
        {
            totpError = ex.Message;
        }
        finally
        {
            disableForm.Password = null;
        }
    }

    /// <summary>What the change-a-password form posts back.</summary>
    private class PasswordForm
    {
        /// <summary>The password in force now.</summary>
        public string? Current { get; set; }

        /// <summary>The password to set.</summary>
        public string? New { get; set; }

        /// <summary>The new password again.</summary>
        public string? Confirm { get; set; }
    }

    /// <summary>What the turn-codes-off form posts back.</summary>
    private class PasswordOnlyForm
    {
        /// <summary>The account's password.</summary>
        public string? Password { get; set; }
    }

    /// <summary>What the confirm-an-authenticator form posts back.</summary>
    private class CodeForm
    {
        /// <summary>The code the authenticator app is showing.</summary>
        public string? Code { get; set; }
    }
}
