@page "/documents/{Id:int}"
@inject TaskCloseOperationService CloseOperations
@inject TimeProvider Clock

<PageTitle>@(document?.DocumentTitle ?? "Document")</PageTitle>

@if (document is null)
{
    <h1>Document</h1>
    <p class="muted">That document no longer exists.</p>
    <a class="btn" href="documents">Back to documents</a>
}
else
{
    <div class="row no-print">
        <a class="btn" href="documents">Back to documents</a>
        <button class="btn btn-primary" type="button" onclick="window.print()">Print</button>
    </div>

    <article class="document">
        <h1>@(document.DocumentTitle ?? document.TaskTitle)</h1>
        <p class="document-meta">
            @document.TaskTitle &middot; completed @DateNames.LongWithTime(document.CompletedAt, Clock.LocalTimeZone)
        </p>
        @if (document.DocumentBody is { Length: > 0 } body)
        {
            <p class="document-body">@body</p>
        }
        else
        {
            <p class="muted no-print">This document has no body: the task it came from had no description.</p>
        }
    </article>

    <p class="muted no-print">
        Use your browser's print dialog, or the Print button, to put this on paper. Everything
        outside the document itself is left off the page.
    </p>
}

@code {
    /// <summary>Id of the document to show.</summary>
    [Parameter]
    public int Id { get; set; }

    private TaskCloseRunView? document;

    /// <summary>Loads the document the run produced.</summary>
    protected override async Task OnParametersSetAsync()
    {
        var run = await CloseOperations.GetRunAsync(Id);
        document = run?.Kind == TaskCloseOperationKind.PrintDocument ? run : null;
    }
}
