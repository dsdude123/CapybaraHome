@inject NavigationManager Navigation

<nav class="nav-bar">
    <a class="brand" href="">CapybaraHome</a>

    <ul class="nav-links">
        <li>
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
        </li>
        <li>
            <NavLink class="nav-link" href="board">Board</NavLink>
        </li>
        <li>
            <NavLink class="nav-link" href="tasks">Tasks</NavLink>
        </li>
        <li>
            <NavLink class="nav-link" href="automations">Automations</NavLink>
        </li>
        <li>
            <a class="nav-link @(OnMeals ? "active" : null)" href="meals">Meals</a>
        </li>
        <li>
            <NavLink class="nav-link" href="meals/plan">Meal Plan</NavLink>
        </li>
        <li>
            <NavLink class="nav-link" href="report">Report</NavLink>
        </li>
        <li>
            <NavLink class="nav-link" href="settings">Settings</NavLink>
        </li>
        <li>
            <NavLink class="nav-link" href="account">Account</NavLink>
        </li>
    </ul>

    <div class="nav-actions">
        <AuthorizeView>
            <Authorized>
                <a class="btn btn-primary btn-small" href="tasks/new">Create</a>
                <form method="post" action="sign-out">
                    <AntiforgeryToken />
                    <button class="btn btn-small" type="submit">Sign out</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </div>
</nav>

@code {
    /// <summary>
    /// Whether the Meals link is the current one. The planning page lives under the same path but
    /// has a link of its own, so a plain prefix match would light both of them at once.
    /// </summary>
    private bool OnMeals
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');
            return path.Equals("meals", StringComparison.OrdinalIgnoreCase)
                || (path.StartsWith("meals/", StringComparison.OrdinalIgnoreCase)
                    && !path.Equals("meals/plan", StringComparison.OrdinalIgnoreCase)
                    && !path.StartsWith("meals/plan/", StringComparison.OrdinalIgnoreCase));
        }
    }
}
